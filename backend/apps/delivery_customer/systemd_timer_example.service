[Unit]
Description=发文跟踪状态更新服务
After=network.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/home/devbox/project/vihhi/weihai_tech_production_system
Environment="PATH=/home/devbox/project/vihhi/weihai_tech_production_system/venv/bin"
ExecStart=/home/devbox/project/vihhi/weihai_tech_production_system/venv/bin/python manage.py update_tracking_status --limit 50

[Install]
WantedBy=multi-user.target
