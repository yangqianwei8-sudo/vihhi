                document.getElementById('mobile-search-btn')?.addEventListener('click', () => {
                    const modal = new bootstrap.Modal(document.getElementById('mobileSearchModal'));
                    modal.show();
                });
            }
            
            setupButtonEvents() {
                // 快速新建按钮
                document.querySelectorAll('#quick-create, #quick-create-overview').forEach(btn => {
                    btn.addEventListener('click', () => this.showQuickCreateMenu());
                });
                
                // 刷新数据按钮
                document.getElementById('refresh-data')?.addEventListener('click', () => this.refreshData());
                
                // 新建工作按钮
                document.getElementById('quick-work')?.addEventListener('click', () => this.showQuickCreateMenu());
                
                // 帮助按钮
                document.getElementById('help-btn')?.addEventListener('click', () => this.showHelpModal());
                
                // 通知按钮
                document.getElementById('notification-btn')?.addEventListener('click', () => this.showNotificationsModal());
                
                // 视图切换
                document.querySelectorAll('[data-view]').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const view = e.currentTarget.dataset.view;
                        this.switchView(view);
                    });
                });
                
                // 待办工作处理
                this.setupPendingWorkInteractions();
            }
            
            setupNavigation() {
                // 保存当前场景到本地存储
                const lastScene = localStorage.getItem('lastActiveScene') || 'overview';
                const lastSceneItem = document.querySelector(`.nav-item[data-scene="${lastScene}"]`);
                if (lastSceneItem && lastScene !== 'overview') {
                    lastSceneItem.click();
                } else {
                    this.switchScene('overview');
                }
            }
            
            switchScene(scene) {
                if (this.currentScene === scene) return;
                
                // 更新导航状态
                document.querySelectorAll('[data-scene]').forEach(item => {
                    item.classList.toggle('active', item.dataset.scene === scene);
                });
                
                // 切换场景内容
                document.querySelectorAll('.scene-content').forEach(content => {
                    content.classList.toggle('active', content.id === `scene-${scene}`);
                    if (content.id !== `scene-${scene}`) {
                        content.style.display = 'none';
                    } else {
                        content.style.display = 'flex';
                    }
                });
                
                this.currentScene = scene;
                this.renderModules(scene);
                
                // 更新页面标题
                const sceneName = document.querySelector(`[data-scene="${scene}"] .text`).textContent;
                document.title = `${sceneName} - 维海科技信息化管理平台`;
                
                // 保存到本地存储
                localStorage.setItem('lastActiveScene', scene);
                
                // 添加场景切换动画
                const activeScene = document.getElementById(`scene-${scene}`);
                if (activeScene) {
                    activeScene.classList.add('slide-in-left');
                    setTimeout(() => {
                        activeScene.classList.remove('slide-in-left');
                    }, 500);
                }
            }
            
            renderModules(scene) {
                const containerId = `${scene}-modules`;
                const container = document.getElementById(containerId);
                if (!container) return;
                
                const modules = this.modulesData
                    .filter(module => module.scene === scene)
                    .sort((a, b) => a.priority - b.priority);
                
                if (modules.length === 0) {
                    container.innerHTML = `
                        <div class="col-12">
                            <div class="text-center py-5">
                                <div class="mb-3">
                                    <i class="bi bi-inbox display-1 text-muted"></i>
                                </div>
                                <h5 class="text-muted mb-2">暂无数据</h5>
                                <p class="text-muted">该场景下暂无功能模块</p>
                                <button class="btn btn-primary mt-3" onclick="platform.switchScene('overview')">
                                    <i class="bi bi-house-door me-2"></i> 返回工作台
                                </button>
                            </div>
                        </div>
                    `;
                    return;
                }
                
                container.innerHTML = modules.map(module => this.createModuleCard(module)).join('');
                
                // 绑定模块交互
                this.setupModuleInteractions(container);
            }
            
            createModuleCard(module) {
                // 统一所有模块的布局：无图标，标题下方有分割线，状态和更新时间在右侧
                return `
