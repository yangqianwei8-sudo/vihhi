        .module-card:hover .module-icon::before {
            opacity: 1;
        }
        
        .module-title-wrapper {
            flex: 1;
            min-width: 0;
        }
        
        .module-title-wrapper.full-width {
            width: 100%;
        }
        
        .module-title {
            font-size: var(--font-size-lg);
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
