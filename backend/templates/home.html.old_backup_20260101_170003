            performSearch(query) {
                if (!query.trim()) {
                    this.showToast('请输入搜索关键词', 'warning');
                    return;
                }
                
                this.showToast(`搜索: ${query}`, 'info');
                
                // 模拟搜索结果显示
                setTimeout(() => {
                    const results = this.modulesData.filter(module => 
                        module.title.toLowerCase().includes(query.toLowerCase()) ||
                        module.description.toLowerCase().includes(query.toLowerCase())
                    );
                    
                    if (results.length > 0) {
                        this.showSearchResults(results, query);
                    } else {
                        this.showToast(`未找到与"${query}"相关的结果`, 'warning');
                    }
                }, 300);
