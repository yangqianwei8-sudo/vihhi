        // 平台管理类
        class ManagementPlatform {
            constructor() {
                this.currentScene = 'overview';
                this.currentDate = new Date();
                this.modulesData = allModules;
                this.isSidebarCollapsed = false;
                this.isDarkMode = false;
                // 状态文本映射（提取为类属性，避免重复定义）
                this.statusTexts = {
                    'normal': '运行正常',
                    'warning': '需要注意',
                    'danger': '存在风险'
                };
                this.initialize();
            }
            
            initialize() {
                this.setupDate();
                this.setupEventListeners();
                this.setupNavigation();
                this.renderModules('overview');
                this.initializeAnimations();
                this.setupKeyboardShortcuts();
                this.loadUserPreferences();
            }
            
            setupDate() {
                const now = new Date();
                const options = { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    weekday: 'long'
                };
                const dateStr = now.toLocaleDateString('zh-CN', options);
                const dateElement = document.getElementById('current-date');
                if (dateElement) {
                    dateElement.textContent = dateStr;
                }
            }
            
            setupEventListeners() {
                // 场景切换
                document.querySelectorAll('[data-scene]').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        const scene = e.currentTarget.dataset.scene;
                        this.switchScene(scene);
                    });
                });
                
                // 快速操作
                document.querySelectorAll('[data-quick-action]').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        const action = e.currentTarget.dataset.quickAction;
                        this.handleQuickAction(action);
                    });
                });
                
                // 常用功能
                document.querySelectorAll('[data-favorite]').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        const favorite = e.currentTarget.dataset.favorite;
                        this.handleFavorite(favorite);
                    });
                });
                
                // 最近访问
                document.querySelectorAll('[data-recent]').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        const recent = e.currentTarget.dataset.recent;
                        this.handleRecent(recent);
                    });
                });
                
                // 按钮事件
                this.setupButtonEvents();
                
                // 搜索功能
                this.setupSearchFunction();
                
