                                                <span style="font-size: var(--font-size-xs); color: var(--vh-primary);">查看审批 →</span>
                                            </div>
                                        </div>
                                    </a>
                                `;
                            }).join('')}
                        </div>
                    </div>
                `;
            } else {
                if (viewAllLink) viewAllLink.style.display = 'none';
                if (emptyText) emptyText.style.display = 'block';
                container.innerHTML = `
                    <div class="info-item" style="padding: var(--spacing-lg); text-align: center; width: 100%; display: flex; align-items: center; justify-content: center; min-height: 60px;">
                        <div class="muted" style="font-size: var(--font-size-base); color: var(--vh-text-muted);">暂无待审批事项</div>
                    </div>
                `;
            }
        };
        
        ManagementPlatform.prototype.initCharts = function() {
            // 图表初始化将在数据渲染后调用
        };
        
        ManagementPlatform.prototype.initTaskStatusChart = function() {
            const canvas = document.getElementById('taskStatusChart');
            if (!canvas || typeof Chart === 'undefined') return;
            
            const dist = homePageData.taskStatusDistribution;
            if (!dist || !dist.labels || !dist.data || dist.labels.length === 0) return;
            
            try {
                new Chart(canvas, {
                    type: 'doughnut',
                    data: {
                        labels: dist.labels,
                        datasets: [{
                            data: dist.data,
                            backgroundColor: dist.colors || ['#E23D3D', '#2563EB', '#16A34A'],
                            borderWidth: 2,
                            borderColor: '#fff',
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 10,
                                    font: { size: 11 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.parsed || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return label + ': ' + value + '个 (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('初始化任务状态分布图失败:', e);
            }
        };
        
