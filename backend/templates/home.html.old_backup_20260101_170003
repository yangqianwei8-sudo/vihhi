<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="description" content="维海科技信息化管理平台 - 企业级综合管理系统，整合客户、合同、生产、财务、人事等核心业务管理功能">
    <meta name="keywords" content="企业管理,信息化,ERP,CRM,维海科技,企业管理系统">
    <title>维海科技信息化管理平台</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- SortableJS for drag and drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <!-- Chart.js for data visualization -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <style>
        :root {
            /* ===== 系统标准变量（与系统样式文件保持一致） ===== */
            
            /* 导航栏尺寸 */
            --nav-expanded-width: 240px;
            --nav-collapsed-width: 80px;
            --nav-width: var(--nav-expanded-width);
            --navbar-height: 56px;
            
            /* 品牌主题色 - 统一使用vh前缀 */
            --vh-primary: #1F2A57;
            --vh-primary-dark: #0F1E3A;
            --vh-primary-light: #1F4A85;
            --vh-primary-muted: #6C7BA8;
            --vh-accent: #D62828;
            --vh-accent-dark: #b61f1f;
            --vh-accent-soft: rgba(214,40,40,0.16);
            
            /* 状态颜色 */
            --vh-success: #16A34A;
            --vh-success-soft: rgba(22, 163, 74, 0.16);
            --vh-warning: #D97706;
            --vh-warning-soft: rgba(217, 119, 6, 0.16);
            --vh-error: #E23D3D;
            --vh-error-soft: rgba(226, 61, 61, 0.16);
            --vh-info: #2563EB;
            --vh-info-soft: rgba(37, 99, 235, 0.16);
            
            /* 中性色 */
            --vh-bg: #F0F3F8;
            --vh-surface: #F0F3F8;
            --vh-card-bg: #ffffff;
            --vh-text: #1F2937;
            --vh-text-muted: #6B7280;
            --vh-text-light: #9CA3AF;
            --vh-border: #E4E8F4;
            --vh-border-light: #F1F5F9;
            
            /* 兼容性变量（向后兼容，映射到vh变量） */
            --primary: var(--vh-primary);
            --primary-light: var(--vh-primary-light);
            --primary-dark: var(--vh-primary-dark);
            --primary-lighter: rgba(31, 42, 87, 0.08);
            --primary-lightest: rgba(31, 42, 87, 0.04);
            --primary-darker: var(--vh-primary-dark);
            --primary-gradient: linear-gradient(135deg, var(--vh-primary) 0%, var(--vh-primary-light) 100%);
            --primary-gradient-light: linear-gradient(135deg, rgba(31, 42, 87, 0.1) 0%, rgba(31, 74, 133, 0.1) 100%);
            --primary-gradient-hover: linear-gradient(135deg, var(--vh-primary-light) 0%, #2F5A9F 100%);
            
            --secondary: #4a9cff;
            --secondary-light: rgba(74, 156, 255, 0.1);
            --secondary-dark: #2d7dd8;
            
            --success: var(--vh-success);
            --success-light: var(--vh-success-soft);
            --success-dark: #15803d;
            
            --warning: var(--vh-warning);
            --warning-light: var(--vh-warning-soft);
            --warning-dark: #b45309;
            
            --danger: var(--vh-error);
            --danger-light: var(--vh-error-soft);
            --danger-dark: #c81e1e;
            
            --info: var(--vh-info);
            --info-light: var(--vh-info-soft);
            --info-dark: #1d4ed8;
            
            /* 中性色映射 */
            --light: #f8f9fa;
            --light-bg: var(--vh-bg);
            --light-hover: #f1f3f5;
            --border: var(--vh-border);
            --border-light: var(--vh-border-light);
            --border-dark: #d1d5db;
            --border-hover: #9ca3af;
            
            /* 文本色映射 */
            --text-primary: var(--vh-text);
            --text-secondary: var(--vh-text-muted);
            --text-tertiary: var(--vh-text-light);
            --text-quaternary: #d1d5db;
            --text-white: #ffffff;
            --text-disabled: var(--vh-text-light);
            
            /* 阴影系统（使用系统标准） */
            --shadow-xs: 0 1px 2px 0 rgba(15, 30, 58, 0.05);
            --shadow-sm: 0 2px 4px rgba(15, 30, 58, 0.05);
            --shadow-md: 0 8px 24px rgba(15, 30, 58, 0.12);
            --shadow-lg: 0 16px 32px rgba(20, 47, 91, 0.16);
            --shadow-xl: 0 24px 60px rgba(20, 47, 91, 0.18);
            --shadow-2xl: 0 25px 50px -12px rgba(15, 30, 58, 0.25);
            --shadow-primary: 0 4px 14px 0 rgba(31, 42, 87, 0.15);
            --shadow-primary-lg: 0 8px 24px 0 rgba(31, 42, 87, 0.2);
            --shadow-primary-xl: 0 12px 32px 0 rgba(31, 42, 87, 0.25);
            --shadow-inner: inset 0 2px 4px 0 rgba(15, 30, 58, 0.06);
            --shadow-colored: 0 4px 14px 0 rgba(31, 42, 87, 0.15), 0 0 0 1px rgba(31, 42, 87, 0.05);
            
            /* 圆角（使用系统标准） */
            --radius-xs: 4px;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 18px;
            --radius-2xl: 24px;
            --radius-full: 999px;
            
            /* 过渡动画（保持精细化缓动函数，但时间与系统一致） */
            --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-base: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-slow: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-bounce: 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            --transition-smooth: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --transition-elastic: 0.5s cubic-bezier(0.68, -0.6, 0.32, 1.6);
            
            /* 布局（与系统保持一致） */
            --header-height: 72px;
            --sidebar-width: var(--nav-expanded-width);
            --sidebar-width-collapsed: var(--nav-collapsed-width);
            --content-padding: var(--spacing-xl);
            --card-padding: var(--spacing-lg);
            --section-gap: var(--spacing-xl);
            
            /* 层级（Z-index管理） */
            --z-dropdown: 1000;
            --z-sticky: 1020;
            --z-fixed: 1030;
            --z-modal-backdrop: 1040;
            --z-modal: 1050;
            --z-popover: 1050;
            --z-tooltip: 1060;
            
            /* 间距系统（使用系统标准） */
            --spacing-xs: 4px;
            --spacing-sm: 8px;
            --spacing-md: 16px;
            --spacing-lg: 24px;
            --spacing-xl: 32px;
            --spacing-2xl: 48px;
            --spacing-3xl: 64px;
            
            /* 字体（使用系统标准） */
            --font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
            --font-size-xs: 11px;
            --font-size-sm: 12px;
            --font-size-base: 14px;
            --font-size-md: 16px;
            --font-size-lg: 18px;
            --font-size-xl: 20px;
            --font-size-2xl: 26px;
            --font-size-3xl: 32px;
        }
        
        /* ===== 基础样式重置 ===== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        html {
            scroll-behavior: smooth;
            /* 防止滚动条导致的布局偏移 */
            scrollbar-gutter: stable;
            /* 优化渲染性能 */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        body {
            font-family: 'Segoe UI', 'Microsoft YaHei', 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--light-bg);
            color: var(--text-primary);
            line-height: 1.6;
            font-size: var(--font-size-base);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
            /* 优化渲染性能 */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            /* 硬件加速 */
            transform: translateZ(0);
            /* 防止布局抖动 */
            scrollbar-gutter: stable;
        }
        
        /* ===== 自定义滚动条 ===== */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
            /* 确保滚动条不占用布局空间 */
            background: transparent;
        }
        
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
            border-radius: var(--radius-full);
            /* 防止布局偏移 */
            margin: 0;
        }
        
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: var(--radius-full);
            transition: background var(--transition-base);
            /* 优化滚动性能 */
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.25);
        }
        
        /* 防止滚动条导致的布局抖动 */
        @supports (scrollbar-gutter: stable) {
            html {
                scrollbar-gutter: stable;
            }
        }
        
        /* ===== 顶部导航栏 - 精细化设计 ===== */
        .main-header {
            background: var(--text-white);
            border-bottom: 1px solid var(--border-light);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1050;
            box-shadow: var(--shadow-sm);
            height: var(--header-height);
            display: flex;
            align-items: center;
            /* 防止抖动 */
            transform: translateZ(0);
            will-change: transform;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }
        
        .header-container {
            width: 100%;
            padding: 0 24px;
        }
        
        /* 品牌标识 */
        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            transition: all var(--transition-fast);
            padding: 8px;
            border-radius: var(--radius-md);
        }
        
        .brand-logo:hover {
            background-color: var(--primary-lighter);
            transform: translateY(-1px);
        }
        
        .logo-icon {
            width: 48px;
            height: 48px;
            background: var(--primary-gradient);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-white);
            font-size: var(--font-size-xl);
            box-shadow: var(--shadow-primary), var(--shadow-md);
            position: relative;
            overflow: hidden;
            transition: all var(--transition-smooth);
        }
        
        .logo-icon::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
            opacity: 0;
            transition: opacity var(--transition-smooth);
        }
        
        .logo-icon::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
            border-radius: var(--radius-md);
        }
        
        .brand-logo:hover .logo-icon {
            transform: scale(1.1) rotate(5deg);
            box-shadow: var(--shadow-primary-xl), var(--shadow-lg);
        }
        
        .brand-logo:hover .logo-icon::before {
            opacity: 1;
        }
        
        .logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }
        
        .logo-title {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.3px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .logo-subtitle {
            font-size: var(--font-size-sm);
            color: var(--text-secondary);
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        
        /* 搜索框 */
        .search-box {
            min-width: 320px;
            max-width: 500px;
            flex: 1;
            margin: 0 24px;
        }
        
        .search-box .input-group {
            border-radius: var(--radius-full);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1.5px solid var(--border);
            transition: all var(--transition-smooth);
            background: var(--text-white);
        }
        
        .search-box .input-group:focus-within {
            border-color: var(--primary);
            box-shadow: var(--shadow-primary-lg), var(--shadow-md);
            transform: translateY(-2px) scale(1.01);
        }
        
        .search-box .input-group:hover:not(:focus-within) {
            border-color: var(--border-dark);
            box-shadow: var(--shadow-md);
        }
        
        .search-box .form-control {
            border: none;
            padding: 14px 20px;
            font-size: var(--font-size-base);
            background: transparent;
            color: var(--text-primary);
            transition: all var(--transition-smooth);
        }
        
        .search-box .form-control::placeholder {
            color: var(--text-tertiary);
            transition: color var(--transition-smooth);
        }
        
        .search-box .form-control:focus {
            box-shadow: none;
            background: transparent;
            outline: none;
        }
        
        .search-box .input-group:focus-within .form-control::placeholder {
            color: var(--text-quaternary);
        }
        
        .search-box .input-group-text {
            background: transparent;
            border: none;
            color: var(--text-tertiary);
            padding: 14px 20px;
            transition: all var(--transition-smooth);
        }
        
        .search-box .input-group:focus-within .input-group-text {
            color: var(--primary);
            transform: scale(1.1);
        }
        
        .search-box .input-group:hover .input-group-text {
            color: var(--text-secondary);
        }
        
        /* 操作按钮 */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .btn-icon {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-full);
            border: 1px solid var(--border);
            background: var(--text-white);
            color: var(--text-secondary);
            transition: all var(--transition-smooth);
            position: relative;
            box-shadow: var(--shadow-xs);
            overflow: hidden;
        }
        
        .btn-icon::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: var(--primary-lighter);
            transform: translate(-50%, -50%);
            transition: width var(--transition-smooth), height var(--transition-smooth);
            z-index: 0;
        }
        
        .btn-icon i {
            position: relative;
            z-index: 1;
            transition: transform var(--transition-smooth);
        }
        
        .btn-icon:hover {
            background: var(--primary-lighter);
            border-color: var(--primary-light);
            color: var(--primary);
            transform: translate3d(0, -3px, 0) scale(1.05);
            box-shadow: var(--shadow-primary), var(--shadow-md);
        }
        
        .btn-icon:hover::before {
            width: 100%;
            height: 100%;
        }
        
        .btn-icon:hover i {
            transform: scale(1.15);
        }
        
        .btn-icon:active {
            transform: translate3d(0, -1px, 0) scale(1.02);
            transition: transform var(--transition-fast);
        }
        
        .btn-icon:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }
        
        .btn-icon .badge {
            position: absolute;
            top: -6px;
            right: -6px;
            font-size: var(--font-size-xs);
            padding: 4px 8px;
            min-width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2.5px solid var(--text-white);
            border-radius: var(--radius-full);
            box-shadow: var(--shadow-sm);
            font-weight: 700;
            transition: all var(--transition-smooth);
            z-index: 10;
        }
        
        .btn-icon:hover .badge {
            transform: scale(1.15);
            box-shadow: var(--shadow-md);
        }
        
        .btn-icon .badge.bg-danger {
            animation: pulse 2s infinite;
        }
        
        /* 用户菜单 */
        .user-dropdown {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px;
            border-radius: var(--radius-full);
            border: 1px solid transparent;
            transition: all var(--transition-base);
            background: transparent;
        }
        
        .user-dropdown:hover {
            background: var(--primary-lighter);
            border-color: var(--border);
        }
        
        .user-avatar {
            width: 44px;
            height: 44px;
            background: var(--primary-gradient);
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-white);
            font-weight: 600;
            font-size: var(--font-size-md);
            box-shadow: var(--shadow-primary), var(--shadow-sm);
            position: relative;
            overflow: hidden;
            transition: all var(--transition-smooth);
        }
        
        .user-avatar::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
            opacity: 0;
            transition: opacity var(--transition-smooth);
        }
        
        .user-avatar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
            border-radius: var(--radius-full);
        }
        
        .user-dropdown:hover .user-avatar {
            transform: scale(1.1) rotate(5deg);
            box-shadow: var(--shadow-primary-xl), var(--shadow-md);
        }
        
        .user-dropdown:hover .user-avatar::before {
            opacity: 1;
        }
        
        .user-avatar.online::before {
            content: '';
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 12px;
            height: 12px;
            background-color: var(--success);
            border-radius: var(--radius-full);
            border: 2.5px solid var(--text-white);
            z-index: 2;
            box-shadow: 0 0 0 2px var(--success-light);
            animation: pulse 2s infinite;
        }
        
        .user-info {
            display: none;
        }
        
        @media (min-width: 992px) {
            .user-info {
                display: flex;
                flex-direction: column;
                line-height: 1.3;
            }
            
            .user-name {
                font-size: var(--font-size-base);
                font-weight: 600;
                color: var(--text-primary);
            }
            
            .user-role {
                font-size: var(--font-size-sm);
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                gap: 4px;
            }
            
            .user-role::before {
                content: '';
                width: 6px;
                height: 6px;
                background-color: var(--success);
                border-radius: var(--radius-full);
                display: inline-block;
            }
        }
        
        /* ===== 主工作区布局 ===== */
        .workspace-wrapper {
            display: flex;
            flex: 1;
            min-height: 0;
            overflow: hidden;
            position: relative;
            width: 100%;
        }
        
        /* ===== 侧边导航栏 - 精细化设计 ===== */
        .scenario-sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;
            background: var(--text-white);
            border-right: 1px solid var(--border-light);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            position: relative;
            transition: width var(--transition-base);
            box-shadow: var(--shadow-sm);
            /* 优化滚动性能 */
            -webkit-overflow-scrolling: touch;
            transform: translateZ(0);
            /* 防止滚动条导致的布局抖动 */
            scrollbar-gutter: stable;
        }
        
        .sidebar-header {
            padding: 24px 20px 16px;
            border-bottom: 1px solid var(--border-light);
        }
        
        .sidebar-title {
            font-size: var(--font-size-sm);
            text-transform: uppercase;
            color: var(--text-secondary);
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }
        
        .sidebar-subtitle {
            font-size: var(--font-size-base);
            color: var(--primary);
            font-weight: 600;
        }
        
        .sidebar-content {
            padding: 20px 0;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .sidebar-section {
            margin-bottom: 28px;
            padding: 0 20px;
        }
        
        .sidebar-section-title {
            font-size: var(--font-size-xs);
            text-transform: uppercase;
            color: var(--text-tertiary);
            font-weight: 600;
            margin-bottom: 12px;
            padding-left: 12px;
            letter-spacing: 0.5px;
        }
        
        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            margin-bottom: 4px;
            border-radius: var(--radius-md);
            color: var(--text-secondary);
            text-decoration: none;
            transition: all var(--transition-smooth);
            border-left: 3px solid transparent;
            gap: 12px;
            position: relative;
            overflow: hidden;
        }
        
        .nav-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, rgba(26, 95, 122, 0.08) 0%, rgba(26, 95, 122, 0.02) 100%);
            opacity: 0;
            transition: opacity var(--transition-smooth);
        }
        
        .nav-item::after {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
