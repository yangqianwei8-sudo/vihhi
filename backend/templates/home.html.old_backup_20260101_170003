            setupModuleInteractions(container) {
                // 模块卡片点击
                container.querySelectorAll('.module-card').forEach(card => {
                    card.addEventListener('click', (e) => {
                        if (e.target.closest('.module-btn')) return;
                        
                        const moduleId = card.getAttribute('data-module');
                        const module = this.modulesData.find(m => m.id === moduleId);
                        if (module) {
                            this.showModuleDetail(module);
                        }
                    });
                });
                
                // 模块按钮点击
                container.querySelectorAll('.module-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const action = btn.getAttribute('data-action');
                        const [moduleId, actionLabel] = action.split('-');
                        const module = this.modulesData.find(m => m.id === moduleId);
                        
                        if (module) {
                            this.showActionToast(module.title, actionLabel);
                        }
                    });
                });
            }
            
            setupPendingWorkInteractions() {
                document.querySelectorAll('.pending-works .btn').forEach((btn, index) => {
                    btn.addEventListener('click', function() {
                        const workItems = document.querySelectorAll('.work-item');
                        const workTitle = workItems[index].querySelector('.work-title').textContent;
                        
                        platform.showToast(`处理工作：${workTitle}`, 'info');
                        
                        // 模拟处理完成
                        if (this.textContent.includes('重新提交') || this.textContent.includes('立即审批')) {
                            const workItem = this.closest('.work-item');
                            workItem.style.opacity = '0.5';
                            setTimeout(() => {
                                workItem.remove();
                                platform.updatePendingCount();
                                platform.showToast('工作项已处理完成', 'success');
                            }, 300);
                        }
                    });
                });
            }
            
            setupSearchFunction() {
                const searchInput = document.getElementById('global-search');
                if (!searchInput) return;
                
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter' && this.value.trim()) {
                        platform.performSearch(this.value.trim());
                    }
                });
            }
            
