        /* ===== 通用样式 ===== */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        
        .section-title {
            font-size: var(--font-size-lg);
            font-weight: 700;
            color: var(--primary);
            margin: 0;
            line-height: 1.3;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .section-title::before {
            content: '';
            width: 4px;
            height: 24px;
            background: var(--primary-gradient);
            border-radius: var(--radius-full);
            display: inline-block;
        }
        
        .section-subtitle {
            font-size: var(--font-size-base);
            color: var(--text-secondary);
            margin: 4px 0 0 0;
            max-width: 600px;
        }
        
        .btn {
            font-weight: 600;
            border-radius: var(--radius-md);
            transition: all var(--transition-base);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: 1px solid transparent;
        }
        
        .btn-sm {
            padding: 8px 16px;
            font-size: var(--font-size-sm);
        }
        
        .btn-primary {
            background: var(--primary-gradient);
            border-color: var(--primary);
            color: var(--text-white);
            box-shadow: var(--shadow-primary), var(--shadow-sm);
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: translate(-50%, -50%);
            transition: width var(--transition-smooth), height var(--transition-smooth);
            z-index: 0;
        }
        
        .btn-primary > * {
            position: relative;
            z-index: 1;
        }
        
        .btn-primary:hover {
            background: var(--primary-gradient-hover);
            border-color: var(--primary-light);
            transform: translateY(-3px) scale(1.02);
            box-shadow: var(--shadow-primary-xl), var(--shadow-lg);
        }
        
        .btn-primary:hover::before {
            width: 300px;
            height: 300px;
        }
        
        .btn-primary:active {
            transform: translateY(-1px) scale(1);
            transition: all var(--transition-fast);
        }
        
        .btn-primary:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }
        
        .btn-outline-primary {
            color: var(--primary);
            border-color: var(--primary);
            background: transparent;
        }
        
        .btn-outline-primary:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: var(--text-white);
            transform: translateY(-2px);
        }
        
        .btn-light {
            background: var(--text-white);
            color: var(--text-secondary);
            border-color: var(--border);
        }
        
        .btn-light:hover {
            background: var(--light);
            border-color: var(--primary-light);
            color: var(--primary);
            transform: translateY(-2px);
        }
        
        /* ===== 自定义组件（精细化） ===== */
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--border-light);
            border-top-color: var(--primary);
            border-right-color: var(--primary-light);
            border-radius: 50%;
            animation: spin 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
            position: relative;
        }
        
        .loading-spinner::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            border: 2px solid var(--primary-lighter);
            border-top-color: var(--primary);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: spin 0.6s linear infinite reverse;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .skeleton-loader {
            background: linear-gradient(90deg, 
                var(--light) 0%, 
                var(--light-hover) 50%, 
                var(--light) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: var(--radius-md);
        }
        
        .skeleton-text {
            height: 16px;
            margin-bottom: 8px;
        }
        
        .skeleton-title {
            height: 24px;
            width: 60%;
            margin-bottom: 12px;
        }
        
        .skeleton-avatar {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-full);
        }
        
        .card-hover-effect {
            transition: all var(--transition-base);
        }
        
        .card-hover-effect:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        
        /* ===== 工具类（精细化） ===== */
        .text-gradient {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            background-size: 200% 200%;
            animation: gradient-shift 3s ease infinite;
        }
        
        @keyframes gradient-shift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        .border-gradient {
            border: 2px solid transparent;
            background: linear-gradient(white, white) padding-box, var(--primary-gradient) border-box;
            position: relative;
        }
        
        .border-gradient::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: inherit;
            padding: 2px;
            background: var(--primary-gradient);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity var(--transition-smooth);
        }
        
        .border-gradient:hover::before {
            opacity: 1;
        }
        
        .shadow-primary {
            box-shadow: var(--shadow-primary);
        }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .hover-lift {
            transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
        }
        
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        
        .smooth-scale {
            transition: transform var(--transition-smooth);
        }
        
        .smooth-scale:hover {
            transform: scale(1.05);
        }
        
        .focus-ring {
            transition: outline var(--transition-fast);
        }
        
        .focus-ring:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }
        
        /* ===== 修复移动端侧边栏滚动问题 ===== */
        .sidebar-content::-webkit-scrollbar {
            height: 6px;
        }
        
        .sidebar-content::-webkit-scrollbar-track {
            background: var(--border-light);
            border-radius: var(--radius-full);
        }
        
        .sidebar-content::-webkit-scrollbar-thumb {
            background: var(--text-tertiary);
            border-radius: var(--radius-full);
        }
        
