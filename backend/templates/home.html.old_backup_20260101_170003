        ManagementPlatform.prototype.setupCardDrag = function() {
            const workspaceMain = document.getElementById('workspaceMain');
            if (!workspaceMain || typeof Sortable === 'undefined') return;
            
            try {
                new Sortable(workspaceMain, {
                    animation: 150,
                    handle: '.info-card-header',
                    ghostClass: 'card-dragging',
                    chosenClass: 'card-chosen',
                    onEnd: function(evt) {
                        // 保存卡片顺序到localStorage
                        const cards = Array.from(workspaceMain.querySelectorAll('[data-card-id]'));
                        const order = cards.map(card => card.dataset.cardId);
                        localStorage.setItem('dashboardCardOrder', JSON.stringify(order));
                    }
                });
            } catch (e) {
                console.error('初始化卡片拖拽失败:', e);
            }
        };
        
