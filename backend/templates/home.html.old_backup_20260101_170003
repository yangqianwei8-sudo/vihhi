            outline-offset: 2px;
        }
        
        .module-header {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
            gap: 16px;
        }
        
        /* 模块标题区域优化样式 */
        .module-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        
        .module-title-row .module-title {
