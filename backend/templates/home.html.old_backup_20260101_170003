        .scene-content.active {
            display: flex;
            opacity: 1;
        }
        
        /* ===== 欢迎区域 - 精细化设计 ===== */
        .welcome-section {
            background: linear-gradient(135deg, rgba(26, 95, 122, 0.05) 0%, rgba(42, 141, 176, 0.05) 100%);
            color: var(--text-primary);
            border-radius: 0;
            padding: var(--spacing-xl);
            margin-bottom: var(--section-gap);
            border: 1px solid rgba(26, 95, 122, 0.1);
            box-shadow: var(--shadow-md), var(--shadow-primary);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
            transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
            /* 防止抖动 */
            transform: translateZ(0);
            will-change: transform;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }
        
        .welcome-section:hover {
            box-shadow: var(--shadow-lg), var(--shadow-primary-lg);
            transform: translate3d(0, -2px, 0);
        }
        
        .welcome-section::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(74, 156, 255, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(100px, -100px);
        }
        
        .welcome-section::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(26, 95, 122, 0.05) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(-50px, 50px);
        }
        
        .welcome-content {
            position: relative;
            z-index: 1;
        }
        
        .welcome-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        
        .welcome-title {
            font-size: var(--font-size-2xl);
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 8px;
            line-height: 1.2;
        }
        
        .welcome-subtitle {
            font-size: var(--font-size-md);
            color: var(--text-secondary);
            margin-bottom: 24px;
            line-height: 1.5;
            max-width: 600px;
        }
        
        .welcome-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .stat-card {
            background: var(--text-white);
            border-radius: 0;
            padding: 16px 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-base);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 180px;
        }
        
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            border-color: var(--primary-light);
        }
        
        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-xl);
            color: var(--text-white);
            flex-shrink: 0;
        }
        
        .stat-info {
            flex: 1;
        }
        
        .stat-value {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
            margin-bottom: 2px;
        }
        
        .stat-label {
            font-size: var(--font-size-sm);
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }
        
        .welcome-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        
        /* ===== 指标卡片 - 精细化设计 ===== */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        
        .metric-card {
            background: var(--text-white);
            border-radius: 0;
            padding: var(--card-padding);
            border: 1px solid var(--border-light);
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-smooth);
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        
        .metric-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-gradient);
            opacity: 0;
            transition: opacity var(--transition-smooth), height var(--transition-smooth);
            z-index: 1;
        }
        
        .metric-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--primary-gradient-light);
            opacity: 0;
            transition: opacity var(--transition-smooth);
            pointer-events: none;
            z-index: 0;
        }
        
        .metric-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: var(--shadow-primary-lg), var(--shadow-lg);
            border-color: var(--primary-light);
            border-width: 1.5px;
        }
        
        .metric-card:hover::before {
            opacity: 1;
            height: 5px;
        }
        
        .metric-card:hover::after {
            opacity: 0.03;
        }
        
        .metric-card:active {
            transform: translateY(-2px) scale(1);
            transition: all var(--transition-fast);
        }
        
        .metric-card:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }
        
        .metric-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }
        
        .metric-title {
            font-size: var(--font-size-sm);
            color: var(--text-secondary);
            font-weight: 500;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .metric-value {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--primary);
            line-height: 1.2;
            margin: 8px 0;
        }
        
        .metric-change {
            font-size: var(--font-size-xs);
            display: flex;
            align-items: center;
            gap: 4px;
            font-weight: 500;
        }
        
        .metric-change.positive {
            color: var(--success);
        }
        
        .metric-change.negative {
            color: var(--danger);
        }
        
        .metric-icon {
            width: 56px;
            height: 56px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-2xl);
            color: var(--text-white);
            opacity: 0.9;
            box-shadow: var(--shadow-primary), var(--shadow-md);
            transition: all var(--transition-smooth);
            position: relative;
            overflow: hidden;
        }
        
        .metric-icon::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
            opacity: 0;
            transition: opacity var(--transition-smooth);
        }
        
        .metric-card:hover .metric-icon {
            transform: scale(1.1) rotate(5deg);
            opacity: 1;
            box-shadow: var(--shadow-primary-xl), var(--shadow-lg);
        }
        
        .metric-card:hover .metric-icon::before {
            opacity: 1;
        }
        
        /* ===== 模块卡片 - 精细化设计 ===== */
        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 24px;
        }
        
        .module-card {
            background: var(--text-white);
            border-radius: 0;
            padding: var(--card-padding);
            border: 1px solid var(--border-light);
            transition: transform var(--transition-smooth), box-shadow var(--transition-smooth), border-color var(--transition-smooth);
            display: flex;
            flex-direction: column;
            height: 100%;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(10px);
            /* 硬件加速优化 */
            transform: translateZ(0);
            will-change: transform;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }
        
        .module-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-gradient);
            opacity: 0;
            transition: opacity var(--transition-smooth), height var(--transition-smooth);
            z-index: 1;
        }
        
        .module-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--primary-gradient-light);
            opacity: 0;
            transition: opacity var(--transition-smooth);
            pointer-events: none;
            z-index: 0;
        }
        
        .module-card:hover {
            border-color: var(--primary-light);
            box-shadow: var(--shadow-primary-lg), var(--shadow-lg);
            transform: translate3d(0, -6px, 0) scale(1.01);
            border-width: 1.5px;
