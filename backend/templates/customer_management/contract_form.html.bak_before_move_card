{% extends "customer_management/base.html" %}
{% load static %}

{% block title %}{{ page_title }} - 维海科技信息化管理平台{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{% static 'css/common.css' %}">
<style>
    .form-group {
        margin-bottom: 20px;
    }
    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
        display: block;
    }
    .required-field::after {
        content: " *";
        color: #ef4444;
    }
    .party-item {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
    }
    .party-item-header {

        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }
</style>
{% endblock %}

{% block breadcrumb_items %}
    <li class="breadcrumb-item"><a href="{% url 'business_pages:contract_management_list' %}">合同管理</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ page_title }}</li>
{% endblock %}

{% block content %}<div class="container-fluid py-4">
    <div class="form-page-title">
            <h1>{{ page_title }}</h1>
            {% if page_description %}
            <p>{{ page_description }}</p>
            {% endif %}
        </div>

    <form method="post" enctype="multipart/form-data" id="contract-form" class="form-card">
        {% csrf_token %}
        {% if form.non_field_errors %}
        <div class="alert alert-danger">
        {% endif %}
            {{ form.non_field_errors }}
        </div>
        <!-- 合同识别功能 -->
        <div class="form-section">
            <div class="form-section-header">
                <h5>🤖 AI合同识别</h5>
                <button type="button" id="recognize-contract-btn" class="btn btn-primary">
                    <i class="bi bi-magic"></i> 开始识别
                </button>
            </div>
            <div class="alert alert-info" style="margin-bottom: 16px; font-size: 13px;">
                <i class="bi bi-info-circle"></i> 上传合同文件（PDF、图片），AI将自动识别并填充表单信息
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">上传合同文件</label>
                        <input type="file" id="contract-file-input" class="form-control"
                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
                               style="padding: 8px;">
                        <small class="form-text text-muted">支持格式：PDF、JPG、PNG、DOC、DOCX，最大10MB</small>
                    </div>
                </div>
            </div>
            <div id="recognition-status" style="display: none; margin-top: 12px;">
                <div class="alert alert-warning">
                    <i class="bi bi-hourglass-split"></i> <span id="recognition-message">正在识别中，请稍候...</span>
                </div>
            </div>
            <div id="recognition-result" style="display: none; margin-top: 12px;">
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i> 识别完成！已自动填充表单信息，请检查并确认。
                </div>
            </div>
        </div>
        <!-- 一、基础信息 -->
        <div class="form-section">
            <div class="form-section-header">
                <h5>基础信息</h5>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">审批单号</label>
                        <input type="text" id="approval_number" name="approval_number" class="form-control" readonly style="background-color: #f5f5f5; cursor: not-allowed;" placeholder="系统自动生成">
                        <small class="form-text text-muted">系统自动生成</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">提交部门</label>
                        <input type="text" id="submit_department" name="submit_department" class="form-control" readonly style="background-color: #f5f5f5; cursor: not-allowed;" value="{% if request.user.department %}{{ request.user.department.name }}{% else %}未设置部门{% endif %}">
                // 创建模式：添加一行默认空行
                serviceContentsTableManager.addRow();
                // 创建模式：添加一行默认空行
                partiesTableManager.addRow();
                        <small class="form-text text-muted">系统默认</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">提交人</label>
                        <input type="text" id="submitter" name="submitter" class="form-control" readonly style="background-color: #f5f5f5; cursor: not-allowed;" value="{{ request.user.get_full_name|default:request.user.username }}">
                        <small class="form-text text-muted">系统默认</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">商务负责人</label>
                        <select id="business_manager" name="business_manager" class="form-select">
                            <option value="">-- 请选择商务负责人 --</option>
                            {% for manager in business_managers %}
                            <option value="{{ manager.id }}" {% if manager.id == user.id %}selected{% endif %}>{{ manager.get_full_name|default:manager.username }}</option>
                            {% endfor %}</select>
                        <small class="form-text text-muted">选择，默认</small>
                    </div>
                </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label required-field">项目编号</label>
                        {{ form.project_number }}
                        {% if form.project_number.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.project_number.errors }}</div>
                        {% endif %}
                        <small class="form-text text-muted">YYYYMMDD-0000，系统自动生成，可手动修改，须保持唯一性</small>
                    </div>
                </div>
                <!-- 合同编号 -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">合同编号</label>
                        {{ form.contract_number }}
                        {% if form.contract_number.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.contract_number.errors }}</div>
                        {% endif %}
                        <small class="form-text text-muted">HT-项目编号，自动生成，可手动修改</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label required-field">关联商机</label>
                        {{ form.opportunity }}
                        {% if form.opportunity.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.opportunity.errors }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label required-field">关联客户</label>
                        {{ form.client }}
                        {% if form.client.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.client.errors }}</div>
                        {% endif %}
                        <small class="form-text text-muted">从关联商机中自动带出</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">项目业态</label>
                        <input type="text" id="project_business_type" name="project_business_type" class="form-control" readonly placeholder="请先选择关联商机">
                        <small class="form-text text-muted">从关联商机中自动带出</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">合同暂定价款</label>
                        <input type="number" id="provisional_price" name="provisional_price" class="form-control" step="0.01" placeholder="0.00">
                        <small class="form-text text-muted">单位：元</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">约定管辖</label>
                        <select id="governing_law" name="governing_law" class="form-select">
                            <option value="">-- 请选择约定管辖 --</option>
                            {% for value, label in governing_law_choices %}
                            <option value="{{ value }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                </div>
            </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">我方签约主体</label>
                        <select id="our_signing_party" name="our_signing_party" class="form-select">
                            <option value="">-- 请选择我方签约主体 --</option>
                            {% for company in our_companies %}
                            <option value="{{ company.company_name }}">{{ company.company_name }}</option>
                            {% endfor %}
                        </select>
                        <small class="form-text text-muted">选择，后台引入</small>
                    </div>
                </div>
        </div>
        <!-- 签约主体 -->
        <div class="form-section">
            <div class="form-section-header">
                <h5>客户联系方式</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="parties-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">序号</th>
                            <th style="width: 180px;">单位名称 <span class="text-danger">*</span></th>
                            <th style="width: 150px;">统一社会信用代码</th>
                            <th style="width: 120px;">法定代表人</th>
                            <th style="width: 120px;">项目负责人</th>
                            <th style="width: 120px;">联系电话</th>
                            <th style="width: 150px;">联系邮箱</th>
                            <th style="width: 200px;">办公地址</th>
                            <th style="width: 80px;">操作</th>
                        </tr>
                    </thead>
                    <tbody id="parties-container">
                        <!-- 签约主体列表将通过JavaScript动态添加 -->
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 16px; text-align: left;">
                <button type="button" class="btn btn-sm btn-primary" id="add-party-btn">
                    <i class="bi bi-plus-circle"></i> 添加签约主体
                </button>
            </div>
        </div>

        <!-- 四、服务信息 -->
        <div class="form-section">
            <div class="form-section-header">
                <h5>服务信息</h5>
            </div>
            <div class="dynamic-table-container">
                <div class="dynamic-table-toolbar">
                    <h4 class="dynamic-table-title">服务信息</h4>
                    <span class="dynamic-table-info">最少保留 1 行</span>
                </div>
                <div class="dynamic-table-wrapper">
                    <table class="dynamic-table">
                        <thead>
                            <tr>
                                <th style="width: 60px;">序号</th>
                                <th style="width: 200px;">服务类型</th>
                                <th style="width: 150px;">图纸阶段</th>
                                <th style="width: 150px;">建筑面积（㎡）</th>
                                <th style="width: 150px;">项目业态</th>
                                <th style="width: 280px;">服务专业</th>
                                <th style="width: 80px;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="service-contents-container">
                            <!-- 服务信息列表将通过JavaScript动态添加 -->
                        </tbody>
                    </table>
                </div>
                <div class="dynamic-table-actions">
                    <button type="button" id="add-service-content-btn" class="dynamic-table-add-btn">添加服务信息</button>
                </div>
            </div>
        </div>

                <!-- 五、价款信息 -->
        <div class="form-section">
            <div class="form-section-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">价款信息</h5>
                <button type="button" class="btn btn-sm btn-primary" id="add-price-info-btn">
                    <i class="bi bi-plus-circle"></i> 添加价款
                </button>
            </div>

            <!-- 结算方式选择 -->
            <div class="row" style="margin-bottom: 20px;">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">结算方式</label>
                        <select id="settlement_method" name="settlement_method" class="form-select">
                            <option value="">-- 请选择结算方式 --</option>
                            {% for method in settlement_methods %}
                            <option value="{{ method.code }}" data-name="{{ method.name }}">{{ method.name }}</option>
                            {% endfor %}
                        </select>
                        <small class="form-text text-muted">后台引入，未选择时隐藏列表</small>
                    </div>
                </div>            
            </div>
            <!-- 金额信息（表单块形式，支持多条） -->
            <div id="price-info-container" style="margin-top: 20px;">
                <!-- 价款信息块将通过JavaScript动态添加 -->
            </div>
            <!-- 根据结算方式显示不同的列表 -->
            <!-- 包干总价列表 -->
            <div id="fixed-total-list" style="display: none;">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">序号</th>
                                <th style="width: 150px;">面积规模</th>
                                <th style="width: 120px;">面积类型</th>
                                <th style="width: 150px;">服务费</th>
                            </tr>
                        </thead>
                        <tbody id="fixed-total-container">
                            <!-- 包干总价列表将通过JavaScript动态添加 -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- 六、附加信息 -->
        <div class="form-section">
            <div class="form-section-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">附加信息</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="additional-info-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">序号</th>
                            <th style="width: 200px;">信息类型</th>
                            <th style="width: 300px;">信息内容</th>
                            <th style="width: 150px;">备注</th>
                            <th style="width: 80px;">操作</th>
                        </tr>
                    </thead>
                    <tbody id="additional-info-container">
                        <!-- 附加信息列表将通过JavaScript动态添加 -->
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 16px; text-align: left;">
                <button type="button" class="btn btn-sm btn-primary" id="add-additional-info-btn">
                    <i class="bi bi-plus-circle"></i> 添加附加信息
                </button>
            </div>
        </div>

        <!-- 七、回款信息 -->
        <div class="form-section">
            <div class="form-section-header">
                <h5>回款信息</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="payment-info-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">序号</th>
                            <th style="width: 120px;">款项名称</th>
                            <th style="width: 150px;">触发节点 <span class="text-danger">*</span></th>
                            <th style="width: 150px;">付款方式 <span class="text-danger">*</span></th>
                            <th style="width: 150px;">回款金额（元）</th>
                            <th style="width: 200px;">付款条件</th>
                            <th style="width: 80px;">操作</th>
                        </tr>
                    </thead>
                    <tbody id="payment-info-container">
                        <!-- 回款信息列表将通过JavaScript动态添加 -->
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 16px; text-align: left;">
                <button type="button" class="btn btn-sm btn-primary" id="add-payment-info-btn">
                    <i class="bi bi-plus-circle"></i> 添加回款信息
                </button>
            </div>
        </div>
        <!-- 三、合同信息 -->
        <div class="form-section">
            <div class="form-section-header">
                <h5>合同信息</h5>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label required-field" for="{{ form.contract_name.id_for_label }}">{{ form.contract_name.label }}</label>
                        {{ form.contract_name }}
                        {% if form.contract_name.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.contract_name.errors }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="{{ form.contract_type.id_for_label }}">{{ form.contract_type.label }}</label>
                        {{ form.contract_type }}
                        {% if form.contract_type.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.contract_type.errors }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="{{ form.structure_type.id_for_label }}">{{ form.structure_type.label }}</label>
                        {{ form.structure_type }}
                        {% if form.structure_type.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.structure_type.errors }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="{{ form.design_unit_category.id_for_label }}">{{ form.design_unit_category.label }}</label>
                        {{ form.design_unit_category }}
                        {% if form.design_unit_category.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.design_unit_category.errors }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="{{ form.contract_amount.id_for_label }}">{{ form.contract_amount.label }}</label>
                        {{ form.contract_amount }}
                        {% if form.contract_amount.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.contract_amount.errors }}</div>
                        {% endif %}
                        <small class="form-text text-muted">单位：元</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="{{ form.tax_rate.id_for_label }}">{{ form.tax_rate.label }}</label>
                        {{ form.tax_rate }}
                        {% if form.tax_rate.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.tax_rate.errors }}</div>
                        {% endif %}
                        <small class="form-text text-muted">默认6%</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label" for="{{ form.description.id_for_label }}">{{ form.description.label }}</label>
                        {{ form.description }}
                        {% if form.description.errors %}
                        <div class="text-danger" style="font-size: 12px; margin-top: 4px;">{{ form.description.errors }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div><script>
    const contractFileInput = document.getElementById('contract-file-input');
    const recognizeBtn = document.getElementById('recognize-contract-btn');
    const recognitionStatus = document.getElementById('recognition-status');
    const recognitionResult = document.getElementById('recognition-result');
    const recognitionMessage = document.getElementById('recognition-message');
    if (recognizeBtn && contractFileInput) {
        recognizeBtn.addEventListener('click', async function() {
            const file = contractFileInput.files[0];
            if (!file) {
                alert('请先选择合同文件');
                return;
            }
            // 检查文件大小
            if (file.size > 10 * 1024 * 1024) {
                alert('文件大小不能超过10MB');
                return;
            }
            // 显示识别状态
            recognitionStatus.style.display = 'block';
            recognitionResult.style.display = 'none';
            recognitionMessage.textContent = '正在识别中，请稍候...';
            recognizeBtn.disabled = true;
            // 创建FormData
            const formData = new FormData();
            formData.append('file', file);
            try {
                // 调用识别API
                const response = await fetch('/api/customer/contracts/recognize/', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
                    }
                });
                const result = await response.json();
                if (result.success) {
                    // 识别成功，填充表单
                    fillFormWithRecognitionResult(result.data);
                    recognitionMessage.textContent = '识别完成！';
                    recognitionStatus.style.display = 'none';
                    recognitionResult.style.display = 'block';
                } else {
                    // 识别失败
                    recognitionMessage.textContent = '识别失败：' + (result.error || '未知错误');
                    recognitionStatus.querySelector('.alert').className = 'alert alert-danger';
                }
            } catch (error) {
                recognitionMessage.textContent = '识别失败：' + error.message;
                recognitionStatus.querySelector('.alert').className = 'alert alert-danger';
            } finally {
                recognizeBtn.disabled = false;
            }
        });
    }
    // 填充表单数据
    function fillFormWithRecognitionResult(data) {
        // 合同名称
        if (data.contract_name) {
            const contractNameField = document.querySelector('[name=]"contract_name"]');
            if (contractNameField && !contractNameField.value) {
                contractNameField.value = data.contract_name;
            }
        // 项目编号（合同编号）
        if (data.contract_number) {
            const contractNumberField = document.querySelector('[name="project_number"]');
            if (contractNumberField && !contractNumberField.value) {
                contractNumberField.value = data.contract_number;
            }
        // 合同类型
        if (data.contract_type) {
            const contractTypeField = document.querySelector('[name="contract_type"]');
            if (contractTypeField) {
                // 尝试匹配合同类型
                const options = contractTypeField.querySelectorAll('option');
                for (let opt of options) {
                    if (opt.textContent.includes(data.contract_type) || data.contract_type.includes(opt.textContent)) {
                        contractTypeField.value = opt.value;
                        break;
                    }
                }
            }
        // 合同描述
        if (data.description) {
            const descField = document.querySelector('[name="description"]');
            if (descField && !descField.value) {
                descField.value = data.description;
            }
        if (data.party_a && data.party_a.name) {
            if (partyRows.length > 0) {
                const firstRow = partyRows[0];
                const partyNameInput = firstRow.querySelector('input[name*="[party_name]"]');
                if (partyNameInput && !partyNameInput.value) {
                    partyNameInput.value = data.party_a.name;
                }
                if (data.party_a.contact) {
                    const contactInput = firstRow.querySelector('input[name*="[party_contact]"]');
                    if (contactInput && !contactInput.value) {
                        contactInput.value = data.party_a.contact;
                    }
                }
                if (data.party_a.phone) {
                    const phoneInput = firstRow.querySelector('input[name*="[contact_phone]"]');
                    if (phoneInput && !phoneInput.value) {
                        phoneInput.value = data.party_a.phone;
