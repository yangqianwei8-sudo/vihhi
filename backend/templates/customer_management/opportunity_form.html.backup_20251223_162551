{% extends "customer_management/base.html" %}
{% block title %}{{ page_title }} - 维海科技信息化管理平台{% endblock %}
{% load static %}
{% block extra_css %}
<link rel="stylesheet" href="{% static 'css/common.css' %}">
<style>
    /* 表单输入文本颜色为绿色（符合样式规范） */
    .form-control,
    .form-select,
    textarea.form-control {
        color: #16A34A; /* 绿色 */
    }

    .form-control:focus,
    .form-select:focus,
    textarea.form-control:focus {
        border-color: #16A34A;
        box-shadow: 0 0 0 0.2rem rgba(22, 163, 74, 0.25);
    }

    .form-control.is-invalid,
    .form-select.is-invalid {
        border-color: var(--vh-error);
    }

    .invalid-feedback {
        display: block;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: var(--vh-error);
    }
    
        /* 顶住顶部导航栏 */
    .opportunity-form-wrapper {
        position: relative;
        margin-top: calc(-1 * var(--navbar-height, 56px) - 12px) !important; /* 抵消body的padding-top和workspace-main的margin-top */
        padding-top: var(--navbar-height, 56px);
        width: 100%;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    .opportunity-form-wrapper .container-fluid {
        padding-left: var(--spacing-md);
        padding-right: var(--spacing-md);
        padding-top: 1rem;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    /* 确保在workspace-main内也能顶住顶部 */
    .workspace-main .opportunity-form-wrapper {
        margin-top: calc(-1 * var(--navbar-height, 56px) - 12px) !important;
    }
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    /* 确保在workspace-main内也能顶住顶部 */
    .workspace-main .opportunity-form-wrapper {
        margin-top: calc(-1 * var(--navbar-height, 56px) - 12px) !important;
    }
    }
</style>
{% endblock %}

{% block content %}
<div class="opportunity-form-wrapper">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">{% if opportunity %}编辑商机{% else %}➕ 新建商机{% endif %}</h2>
                <p class="text-muted mb-0">{% if opportunity %}编辑商机信息{% else %}创建新的商机记录{% endif %}</p>
            </div>
            <a href="{% if opportunity %}{% url 'business_pages:opportunity_detail' opportunity.id %}{% else %}{% url 'business_pages:opportunity_management' %}{% endif %}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> 返回列表
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" id="opportunityForm" novalidate>
                    {% csrf_token %}
                    
                    <!-- 表单错误提示 -->
                    {% if messages %}
                    <div class="mb-4">
                        {% for message in messages %}
                        <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                    
                    <!-- 基本信息 -->
                    <div class="mb-4">
                        <h5 class="mb-3">基本信息</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">商机编号</label>
                                <input type="text" id="opportunity_number_preview" class="form-control" 
                                       value="{% if opportunity %}{{ opportunity.opportunity_number|default:'' }}{% else %}{{ preview_opportunity_number|default:'' }}{% endif %}" 
                                       readonly 
                                       disabled
                                       style="background-color: #f8f9fa; color: #6c757d; cursor: not-allowed;">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">关联客户 <span class="text-danger">*</span></label>

                                <div class="input-group">
                                    <select name="client_id" class="form-select" required id="client_select">
                                        <option value="">请选择客户</option>
                                        {% for client in clients %}
                                        <option value="{{ client.id }}" 
                                                {% if opportunity.client_id == client.id %}selected{% endif %}
                                                data-responsible-user-id="{% if client.responsible_user %}{{ client.responsible_user.id }}{% else %}{% endif %}">
                                            {{ client.name }}
                                        </option>
                                        {% endfor %}
                                    </select>
                                    <a href="{% url 'business_pages:customer_create' %}" target="_blank" class="btn btn-outline-primary" title="新建客户">
                                        <i class="bi bi-plus-circle"></i> 新建
                                    </a>
                                </div>
                                {% if not clients %}
                                <small class="text-warning">
                                    <i class="bi bi-exclamation-triangle"></i> 暂无客户数据，请先
                                    <a href="{% url 'business_pages:customer_create' %}" target="_blank">创建客户</a>
                                </small>
                                {% endif %}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">商机类型</label>
                                <select name="opportunity_type" class="form-select">
                                    <option value="">请选择</option>
                                    <option value="project_cooperation" {% if opportunity.opportunity_type == 'project_cooperation' %}selected{% endif %}>项目合作</option>
                                    <option value="centralized_procurement" {% if opportunity.opportunity_type == 'centralized_procurement' %}selected{% endif %}>集中采购</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">服务类型</label>
                                <select name="service_type_id" class="form-select">
                                    <option value="">请选择服务类型</option>
                                    {% for service_type in service_types %}
                                    <option value="{{ service_type.id }}" {% if opportunity.service_type_id == service_type.id %}selected{% endif %}>{{ service_type.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- 项目信息 -->
                    <div class="mb-4">
                        <h5 class="mb-3">项目信息</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">项目名称</label>
                                <input type="text" name="project_name" class="form-control" 
                                       value="{{ opportunity.project_name|default:'' }}" 
                                       maxlength="200" 
                                       placeholder="请输入项目名称">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">项目业态</label>
                                <select name="project_type" class="form-select">
                                    <option value="">请选择项目业态</option>
                                    {% for value, label in business_types %}
                                    <option value="{{ value }}" {% if opportunity.project_type|default:'' == value %}selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">建筑面积（平方米）</label>
                                <input type="number" name="building_area" class="form-control" 
                                       value="{% if opportunity.building_area %}{{ opportunity.building_area }}{% endif %}" 
                                       step="0.01" min="0" 
                                       placeholder="0.00">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">图纸阶段</label>
                                <select name="drawing_stage" class="form-select">
                                    <option value="">请选择</option>
                                    {% for stage in design_stages %}
                                    <option value="{{ stage.id }}" {% if opportunity.drawing_stage_id == stage.id %}selected{% endif %}>
                                        {{ stage.name }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">项目地址</label>
                            <input type="hidden" name="project_address" id="projectAddressField" value="{{ opportunity.project_address|default:'' }}">
                            <!-- 地址引入功能 -->
                            <div class="mb-3">
                                <div class="input-group">
                                    <input type="text" id="addressImportInput" class="form-control" 
                                           placeholder="输入完整地址，点击引入按钮自动解析省市区和详细地址">
                                    <button type="button" class="btn btn-outline-primary" id="addressImportBtn">
                                        <i class="bi bi-geo-alt"></i> 地址引入
                                    </button>
                                </div>
                                <small class="form-text text-muted">支持输入完整地址，系统将自动解析并填充省市区信息</small>
                                <div id="addressImportStatus" class="mt-2" style="display: none;"></div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-4">
                                    <select id="provinceSelect" class="form-select">
                                        <option value="">选择省份</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="citySelect" class="form-select">
                                        <option value="">选择城市</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="districtSelect" class="form-select">
                                        <option value="">选择区县</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <input type="text" id="addressDetailInput" class="form-control" 
                                           placeholder="街道、楼栋、门牌等详细地址" 
                                           value="">
                                    <small class="form-text text-muted">完整地址会在保存前自动组合</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 金额信息 -->
                    <div class="mb-4">
                        <h5 class="mb-3">金额信息</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">预计金额（元） <span class="text-danger">*</span></label>
                                <input type="number" name="estimated_amount" id="estimated_amount" class="form-control" 
                                       value="{% if opportunity.estimated_amount %}{{ opportunity.estimated_amount }}{% else %}0{% endif %}" 
                                       step="0.01" min="0" required 
                                       placeholder="0.00">
                                <div class="invalid-feedback">请输入有效的预计金额</div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">成功概率（%） <span class="text-danger">*</span></label>
                                <select name="success_probability" id="success_probability" class="form-select" required>
                                    <option value="10" {% if opportunity.success_probability == 10 or not opportunity %}selected{% endif %}>10%</option>
                                    <option value="30" {% if opportunity.success_probability == 30 %}selected{% endif %}>30%</option>
                                    <option value="50" {% if opportunity.success_probability == 50 %}selected{% endif %}>50%</option>
                                    <option value="70" {% if opportunity.success_probability == 70 %}selected{% endif %}>70%</option>
                                    <option value="90" {% if opportunity.success_probability == 90 %}selected{% endif %}>90%</option>
                                </select>
                                <small class="form-text text-muted">根据商机当前阶段选择对应的成功概率</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">加权金额（元）</label>
                                <input type="text" id="weighted_amount_display" class="form-control" 
                                       value="{% if opportunity.weighted_amount %}{{ opportunity.weighted_amount|floatformat:2 }}{% else %}0.00{% endif %}" 
                                       readonly 
                                       style="background-color: #f8f9fa; color: #6c757d;">
                                <small class="form-text text-muted">自动计算：预计金额 × 成功概率</small>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 时间信息 -->
                    <div class="mb-4">
                        <h5 class="mb-3">时间信息</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">预计签约时间</label>
                                <input type="date" name="expected_sign_date" class="form-control" 
                                       value="{{ opportunity.expected_sign_date|default:''|date:'Y-m-d' }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">紧急程度</label>
                                <select name="urgency" class="form-select">
                                    {% for value, label in urgency_choices %}
                                    <option value="{{ value }}" {% if opportunity.urgency == value or not opportunity and value == 'normal' %}selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 商机描述 -->
                    <div class="mb-4">
                        <h5 class="mb-3">商机描述</h5>
                        <div class="mb-3">
                            <label class="form-label">描述</label>
                            <textarea name="description" class="form-control" rows="4" 
                                      placeholder="请输入商机描述">{{ opportunity.description|default:'' }}</textarea>
                        </div>
                    </div>

                    <!-- 操作按钮 -->
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{% if opportunity %}{% url 'business_pages:opportunity_detail' opportunity.id %}{% else %}{% url 'business_pages:opportunity_management' %}{% endif %}" 
                           class="btn btn-secondary">
                            取消
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> {% if opportunity %}保存修改{% else %}创建{% endif %}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="{% static 'js/amap-district-selector.js' %}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const estimatedAmountInput = document.getElementById('estimated_amount');
    const successProbabilitySelect = document.getElementById('success_probability');
    const weightedAmountDisplay = document.getElementById('weighted_amount_display');
    
    function calculateWeightedAmount() {
        const estimatedAmount = parseFloat(estimatedAmountInput.value) || 0;
        const successProbability = parseFloat(successProbabilitySelect.value) || 0;
        const weightedAmount = (estimatedAmount * successProbability / 100).toFixed(2);
        weightedAmountDisplay.value = weightedAmount;
    }
    
    if (estimatedAmountInput && successProbabilitySelect && weightedAmountDisplay) {
        estimatedAmountInput.addEventListener('input', calculateWeightedAmount);
        successProbabilitySelect.addEventListener('change', calculateWeightedAmount);
        calculateWeightedAmount();
    }
    
    // 地址引入功能
    const addressImportInput = document.getElementById('addressImportInput');
    const addressImportBtn = document.getElementById('addressImportBtn');
    const addressImportStatus = document.getElementById('addressImportStatus');
    
    if (addressImportBtn && addressImportInput) {
        addressImportBtn.addEventListener('click', async function() {
            const address = addressImportInput.value.trim();
            if (!address) {
                addressImportStatus.innerHTML = '<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> 请输入地址</div>';
                addressImportStatus.style.display = 'block';
                return;
            }
            
            // 显示加载状态
            addressImportBtn.disabled = true;
            addressImportBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 解析中...';
            addressImportStatus.innerHTML = '<div class="alert alert-info"><i class="bi bi-hourglass-split"></i> 正在解析地址...</div>';
            addressImportStatus.style.display = 'block';
            
            try {
                const response = await fetch(`/api/customer/geocode/?address=${encodeURIComponent(address)}`);
                const data = await response.json();
                
                if (data.success) {
                    // 解析成功，填充省市区和详细地址
                    const provinceSelect = document.getElementById('provinceSelect');
                    const citySelect = document.getElementById('citySelect');
                    const districtSelect = document.getElementById('districtSelect');
                    const addressDetailInput = document.getElementById('addressDetailInput');
                    
                    // 检查选择器是否已初始化
                    if (!window.districtSelectorReady) {
                        addressImportStatus.innerHTML = '<div class="alert alert-info"><i class="bi bi-hourglass-split"></i> 正在等待省市区数据加载，请稍候...</div>';
                        addressImportStatus.style.display = 'block';
                    }
                    
                    // 等待省份数据加载完成
                    const waitForProvinces = () => {
                        return new Promise((resolve) => {
                            if (provinceSelect && provinceSelect.options.length > 1) {
                                resolve();
                                return;
                            }
                            // 如果省份数据还没加载，等待最多3秒
                            let attempts = 0;
                            const checkInterval = setInterval(() => {
                                attempts++;
                                if (provinceSelect && provinceSelect.options.length > 1) {
                                    clearInterval(checkInterval);
                                    resolve();
                                } else if (attempts >= 30) { // 3秒后超时
                                    clearInterval(checkInterval);
                                    resolve(); // 即使超时也继续，可能数据加载失败
                                }
                            }, 100);
                        });
                    };
                    
                    // 等待并填充省份
                    await waitForProvinces();
                    
                    if (data.province && provinceSelect) {
                        const provinceOptions = Array.from(provinceSelect.options);
                        const provinceOption = provinceOptions.find(opt => 
                            opt.textContent.includes(data.province) || 
                            opt.textContent === data.province ||
                            opt.dataset.name === data.province
                        );
                        
                        if (provinceOption && provinceOption.value) {
                            provinceSelect.value = provinceOption.value;
                            const changeEvent = new Event('change', { bubbles: true });
                            provinceSelect.dispatchEvent(changeEvent);
                            
                            // 等待城市数据加载
                            const waitForCities = () => {
                                return new Promise((resolve) => {
                                    setTimeout(() => {
                                        if (citySelect && citySelect.options.length > 1) {
                                            resolve();
                                        } else {
                                            // 等待最多2秒
                                            let attempts = 0;
                                            const checkInterval = setInterval(() => {
                                                attempts++;
                                                if (citySelect && citySelect.options.length > 1) {
                                                    clearInterval(checkInterval);
                                                    resolve();
                                                } else if (attempts >= 20) {
                                                    clearInterval(checkInterval);
                                                    resolve();
                                                }
                                            }, 100);
                                        }
                                    }, 300);
                                });
                            };
                            
                            await waitForCities();
                            
                            // 选择城市
                            if (data.city && citySelect) {
                                const cityOptions = Array.from(citySelect.options);
                                const cityOption = cityOptions.find(opt => 
                                    opt.textContent.includes(data.city) || 
                                    opt.textContent === data.city ||
                                    opt.dataset.name === data.city
                                );
                                
                                if (cityOption && cityOption.value) {
                                    citySelect.value = cityOption.value;
                                    const cityChangeEvent = new Event('change', { bubbles: true });
                                    citySelect.dispatchEvent(cityChangeEvent);
                                    
                                    // 等待区县数据加载
                                    const waitForDistricts = () => {
                                        return new Promise((resolve) => {
                                            setTimeout(() => {
                                                if (districtSelect && districtSelect.options.length > 1) {
                                                    resolve();
                                                } else {
                                                    let attempts = 0;
                                                    const checkInterval = setInterval(() => {
                                                        attempts++;
                                                        if (districtSelect && districtSelect.options.length > 1) {
                                                            clearInterval(checkInterval);
                                                            resolve();
                                                        } else if (attempts >= 20) {
                                                            clearInterval(checkInterval);
                                                            resolve();
                                                        }
                                                    }, 100);
                                                }
                                            }, 300);
                                        });
                                    };
                                    
                                    await waitForDistricts();
                                    
                                    // 选择区县
                                    if (data.district && districtSelect) {
                                        const districtOptions = Array.from(districtSelect.options);
                                        const districtOption = districtOptions.find(opt => 
                                            opt.textContent.includes(data.district) || 
                                            opt.textContent === data.district ||
                                            opt.dataset.name === data.district
                                        );
                                        
                                        if (districtOption && districtOption.value) {
                                            districtSelect.value = districtOption.value;
                                        }
                                    }
                                }
                            }
                        } else {
                            addressImportStatus.innerHTML += '<div class="alert alert-warning mt-2"><i class="bi bi-exclamation-triangle"></i> 未找到匹配的省份，请手动选择</div>';
                        }
                    }
                    
                    // 填充详细地址（去除省市区后的部分）
                    if (addressDetailInput && data.formatted_address) {
                        let detailAddress = data.formatted_address;
                        if (data.province) detailAddress = detailAddress.replace(data.province, '');
                        if (data.city) detailAddress = detailAddress.replace(data.city, '');
                        if (data.district) detailAddress = detailAddress.replace(data.district, '');
                        addressDetailInput.value = detailAddress.trim();
                    }
                    
                    addressImportStatus.innerHTML = '<div class="alert alert-success"><i class="bi bi-check-circle"></i> 地址解析成功！已自动填充省市区信息</div>';
                    addressImportStatus.style.display = 'block';
                } else {
                    addressImportStatus.innerHTML = `<div class="alert alert-danger"><i class="bi bi-x-circle"></i> ${data.message || '地址解析失败'}</div>`;
                    addressImportStatus.style.display = 'block';
                }
            } catch (error) {
                console.error('地址引入失败:', error);
                addressImportStatus.innerHTML = '<div class="alert alert-danger"><i class="bi bi-x-circle"></i> 地址解析失败，请检查网络连接或稍后重试</div>';
                addressImportStatus.style.display = 'block';
            } finally {
                addressImportBtn.disabled = false;
                addressImportBtn.innerHTML = '<i class="bi bi-geo-alt"></i> 地址引入';
            }
        });
    }
    
    // 初始化省市区选择器
    const districtSelector = new AmapDistrictSelector({
        provinceSelectId: 'provinceSelect',
        citySelectId: 'citySelect',
        districtSelectId: 'districtSelect',
        addressFieldId: 'projectAddressField',
        detailInputId: 'addressDetailInput',
        apiBaseUrl: '/api/customer/districts/',
        autoUpdateAddress: true,
        enableLogging: false
    });
    districtSelector.init();
    
    // 标记选择器已初始化
    window.districtSelectorReady = false;
    // 监听省份数据加载完成
    const provinceSelect = document.getElementById('provinceSelect');
    if (provinceSelect) {
        const checkProvinceLoaded = setInterval(() => {
            if (provinceSelect.options.length > 1) {
                window.districtSelectorReady = true;
                clearInterval(checkProvinceLoaded);
            }
        }, 200);
        // 10秒后停止检查
        setTimeout(() => clearInterval(checkProvinceLoaded), 10000);
    }
    
    const form = document.getElementById('opportunityForm');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        }, false);
    }
    
    
});
</script>
{% endblock %}
