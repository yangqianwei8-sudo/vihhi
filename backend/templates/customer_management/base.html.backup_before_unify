<body>
    {% include "shared/_top_nav.html" %}

    <div class="container-fluid">
        {% if messages %}
        <div class="alert-container">
            {% for message in messages %}
                <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        </div>
        {% endif %}

        

                {% if module_sidebar_nav %}
        {# 客户管理布局 - 使用统一样式模板，带左侧菜单 #}
        <div class="workspace workspace-two-column customer-management-layout">
            <!-- 左侧导航菜单 -->
            <aside class="workspace-nav">
                <nav class="sidenav">
                    <div class="sidenav-section">
                        <div class="sidenav-links">
                            {% for menu_group in module_sidebar_nav %}
                            <div class="sidenav-item {% if menu_group.active or menu_group.expanded %}expanded{% endif %}">
                                <a class="sidenav-link" 
                                   href="{% if menu_group.url %}{{ menu_group.url }}{% else %}#{% endif %}" 
                                   {% if menu_group.active %}data-active="true"{% endif %}>
                                    {% if menu_group.icon %}<span>{{ menu_group.icon }}</span>{% endif %}
                                    <span>{{ menu_group.label }}</span>
                                    
                                </a>
                                {% if menu_group.children %}
                                <div class="submenu">
                                    {% for child in menu_group.children %}
                                    <a class="sidenav-link sidenav-sub-link" 
                                       href="{{ child.url }}" 
                                       {% if child.active %}data-active="true"{% endif %}>
                                        {% if child.icon %}<span>{{ child.icon }}</span>{% endif %}
                                        <span>{{ child.label }}</span>
                                    </a>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </nav>
            </aside>

            <!-- 主内容区域 -->
            <main class="workspace-main customer-content">
            {% block content %}
            {% endblock %}
            </main>
        </div>
        {% else %}
        <div class="workspace-content">
        </div>
        </div>
        {% endif %}
    <script>
        // Bootstrap JS fallback with enhanced error handling
        (function() {
            // 如果Bootstrap已加载，无需处理
            if (typeof bootstrap !== 'undefined') {
                console.log('✅ Bootstrap JS 已加载');
                return;
            }
            
            var bootstrapJSCDNs = [
                'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js',
                'https://cdn.bootcdn.net/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js',
                'https://lf26-cdn-tos.bytecdntp.com/cdn/expire-1-M/bootstrap/5.3.0/js/bootstrap.bundle.min.js',
                'https://unpkg.com/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js',
                'https://cdn.staticfile.org/bootstrap/5.3.0/js/bootstrap.bundle.min.js',
                '/static/js/bootstrap.bundle.min.js'
            ];
            
            var currentIndex = 0;
            var maxAttempts = bootstrapJSCDNs.length;
            
            function loadBootstrapJS() {
                if (currentIndex >= maxAttempts) {
                    console.error('❌ 所有Bootstrap JS CDN源均加载失败');
                    
                    // 模拟Bootstrap功能（基础回退）
                    fallbackBootstrapFeatures();
                    return;
                }
                
                var cdnUrl = bootstrapJSCDNs[currentIndex];
                console.log('🔄 尝试加载Bootstrap JS (' + (currentIndex + 1) + '/' + maxAttempts + '):', cdnUrl);
                
                var script = document.createElement('script');
                script.src = cdnUrl;
                script.integrity = currentIndex === 0 ? 'sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz' : '';
                script.crossOrigin = currentIndex === 0 ? 'anonymous' : '';
                
                script.onload = function() {
                    console.log('✅ Bootstrap JS加载成功: ' + cdnUrl);
                    
                    // 验证Bootstrap功能是否完整
                    setTimeout(function() {
                        if (typeof bootstrap !== 'undefined') {
                            console.log('🎉 Bootstrap初始化成功');
                            
                            // 重新初始化页面上的Bootstrap组件
                            initBootstrapComponents();
                            
                            // 记录CDN使用情况
                            if (window.cdnStatus) {
                                window.cdnStatus.js.fallbackUsed = currentIndex > 0;
                                window.cdnStatus.js.fallbackIndex = currentIndex;
                                window.cdnStatus.js.fallbackUrl = cdnUrl;
                            }
                        } else {
                            console.warn('⚠️ Bootstrap对象未定义，尝试下一个CDN');
                            currentIndex++;
                            loadBootstrapJS();
                        }
                    }, 100);
                };
                
                script.onerror = function() {
                    console.warn('⚠️ Bootstrap JS加载失败: ' + cdnUrl);
                    currentIndex++;
                    
                    // 指数退避重试
                    var delay = Math.min(1000 * Math.pow(1.5, currentIndex), 5000);
                    setTimeout(loadBootstrapJS, delay);
                };
                
                document.body.appendChild(script);
            }
            
            function fallbackBootstrapFeatures() {
                console.log('🛠️ 启用Bootstrap基础功能回退');
                
                // 手动实现下拉菜单基础功能
                document.querySelectorAll('.dropdown-toggle').forEach(function(toggle) {
                    toggle.addEventListener('click', function(e) {
                        e.preventDefault();
                        var menu = this.nextElementSibling;
                        if (menu && menu.classList.contains('dropdown-menu')) {
                            menu.classList.toggle('show');
                        }
                    });
                });
                
                // 点击外部关闭下拉菜单
                document.addEventListener('click', function(e) {
                    if (!e.target.closest('.dropdown')) {
                        document.querySelectorAll('.dropdown-menu.show').forEach(function(menu) {
                            menu.classList.remove('show');
                        });
                    }
                });
            }
            
            function initBootstrapComponents() {
                // 初始化所有需要JS的Bootstrap组件
                if (typeof bootstrap !== 'undefined') {
                    var dropdowns = document.querySelectorAll('.dropdown-toggle');
                    dropdowns.forEach(function(dropdown) {
                        try {
                            new bootstrap.Dropdown(dropdown);
                        } catch(e) {
                            console.warn('初始化Dropdown失败:', e);
                        }
                    });
                    
                    // 初始化模态框等组件
                    console.log('🔧 Bootstrap组件初始化完成');
                }
            }
            
            // 延迟加载，优先让CSS加载完成
            setTimeout(loadBootstrapJS, 500);
        })();
    </script>
