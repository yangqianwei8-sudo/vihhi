<!-- CDN健康监控与报告 -->
    <script>
        // CDN健康监控与报告
        (function() {
            // 记录CDN使用情况
            var cdnPerformance = {
                css: {
                    primary: 'cdn.jsdelivr.net',
                    fallbackUsed: false,
                    fallbackIndex: -1,
                    fallbackUrl: ''
                },
                js: {
                    primary: 'cdn.jsdelivr.net',
                    fallbackUsed: false,
                    fallbackIndex: -1,
                    fallbackUrl: ''
                },
                timestamp: new Date().toISOString()
            };
            
            // 暴露给全局以便调试
            window.cdnStatus = cdnPerformance;
            
            // 发送到分析平台（示例）
            function reportCDNStatus() {
                // 发送到Google Analytics
                if (typeof gtag === 'function') {
                    gtag('event', 'cdn_performance', {
                        'event_category': 'performance',
                        'event_label': JSON.stringify(cdnPerformance),
                        'non_interaction': true
                    });
                }
                
                // 或发送到自己的监控端点（可选）
                // fetch('/api/monitor/cdn-status/', {
                //     method: 'POST',
                //     headers: {
                //         'Content-Type': 'application/json',
                //     },
                //     body: JSON.stringify(cdnPerformance),
                //     keepalive: true // 确保在页面卸载时也能发送
                // }).catch(function() {
                //     // 静默失败
                // });
            }
            
            // 页面卸载前发送报告
            window.addEventListener('beforeunload', function() {
                reportCDNStatus();
            });
            
            // 或页面加载完成后发送
            if (document.readyState === 'complete') {
                setTimeout(reportCDNStatus, 3000);
            } else {
                window.addEventListener('load', function() {
                    setTimeout(reportCDNStatus, 3000);
                });
            }
        })();
    </script>
