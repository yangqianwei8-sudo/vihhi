    <!-- Bootstrap CSS with CDN fallback -->
        <!-- CDN预加载优化 -->
    <link rel="preconnect" href="https://cdn.bootcdn.net" crossorigin>
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="dns-prefetch" href="https://lf9-cdn-tos.bytecdntp.com">
    <link rel="dns-prefetch" href="https://cdn.staticfile.org">
    <link id="bootstrap-css" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="{% static "css/bootstrap-icons/bootstrap-icons.css" %}">
    <link rel="stylesheet" href="{% static 'css/common.css' %}">
        <script>
// Bootstrap CSS fallback: 简化版检测，避免过度敏感
        (function() {
            var fallbackCDNs = [
                {
                    bootstrap: 'https://cdn.bootcdn.net/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css',
                    icons: 'https://cdn.bootcdn.net/ajax/libs/bootstrap-icons/1.11.0/font/bootstrap-icons.min.css'
                },
                {
                    bootstrap: 'https://lf9-cdn-tos.bytecdntp.com/cdn/expire-1-M/bootstrap/5.3.0/css/bootstrap.min.css',
                    icons: 'https://lf3-cdn-tos.bytecdntp.com/cdn/expire-1-M/bootstrap-icons/1.11.0/font/bootstrap-icons.min.css'
                },
                {
                    bootstrap: 'https://unpkg.com/bootstrap@5.3.0/dist/css/bootstrap.min.css',
                    icons: 'https://unpkg.com/bootstrap-icons@1.11.0/font/bootstrap-icons.css'
                },
                {
                    bootstrap: '/static/css/bootstrap.min.css',
                    icons: '/static/css/bootstrap-icons.min.css'
                }
            ];
            
            var currentFallbackIndex = 0;
            var MAX_CHECK_ATTEMPTS = 3; // 最大检测次数
            var checkAttempts = 0;
            var cssConfirmedLoaded = false; // CSS加载确认标记
            
            function checkAndSwitch() {
                // 如果已确认加载或达到最大检测次数，停止检测
                if (cssConfirmedLoaded || checkAttempts >= MAX_CHECK_ATTEMPTS) {
                    if (checkAttempts >= MAX_CHECK_ATTEMPTS) {
                        console.log('🔒 已达到最大检测次数，停止检测循环');
                    }
                    return;
                }
                
                checkAttempts++;
                console.log('🔍 检测尝试 ' + checkAttempts + '/' + MAX_CHECK_ATTEMPTS);
                
                var bootstrapCss = document.getElementById('bootstrap-css');
                var needSwitch = false;
                
                if (bootstrapCss) {
                    // 方法1：检查sheet是否存在（最基本检测）
                    if (!bootstrapCss.sheet) {
                        console.log('📭 CSS sheet属性不存在（尝试' + checkAttempts + '）');
                        needSwitch = true;
                    } else {
                        // 方法2：简化版视觉检测（不读取cssRules，避免跨域错误）
                        try {
                            var testEl = document.createElement('div');
                            testEl.className = 'd-none';
                            testEl.style.position = 'absolute';
                            testEl.style.left = '-9999px';
                            document.body.appendChild(testEl);
                            
                            var computedStyle = window.getComputedStyle(testEl);
                            if (computedStyle.display === 'none') {
                                console.log('✅ CSS视觉检测通过 - Bootstrap已加载');
                                cssConfirmedLoaded = true;
                                needSwitch = false;
                            } else {
                                console.log('⚠️ CSS视觉检测未通过');
                                needSwitch = true;
                            }
                            
                            document.body.removeChild(testEl);
                        } catch (e) {
                            // 视觉检测失败，但sheet存在，假定CSS已加载
                            console.log('📄 CSS sheet存在，假定已加载成功');
                            cssConfirmedLoaded = true;
                            needSwitch = false;
                        }
                    }
                    
                    // 第一次检测时，如果sheet不存在，可能是还在加载，稍等再试
                    if (needSwitch && checkAttempts === 1 && !bootstrapCss.sheet) {
                        console.log('⏳ CSS可能正在加载，等待后重试...');
                        setTimeout(checkAndSwitch, 800);
                        return;
                    }
                }
                
                // 执行CDN切换
                if (needSwitch && currentFallbackIndex < fallbackCDNs.length) {
                    var fallback = fallbackCDNs[currentFallbackIndex];
                    
                    console.log('🔀 切换到备用CDN ' + (currentFallbackIndex + 1) + ':', {
                        bootstrap: fallback.bootstrap.substring(0, 50) + '...',
                        icons: fallback.icons.substring(0, 50) + '...'
                    });
                    
                    // 切换Bootstrap CSS
                    if (bootstrapCss && bootstrapCss.href.indexOf('cdn.jsdelivr.net') !== -1) {
                        bootstrapCss.href = fallback.bootstrap;
                    }
                    
                    // 切换Icons CSS（如果存在）
                    var iconsCss = document.getElementById('bootstrap-icons-css');
                    if (iconsCss && iconsCss.href && iconsCss.href.indexOf('cdn.jsdelivr.net') !== -1) {
                        iconsCss.href = fallback.icons;
                    }
                    
                    currentFallbackIndex++;
                    
                    // 切换后等待1.5秒再检测
                    setTimeout(checkAndSwitch, 1500);
                    
                } else if (needSwitch && currentFallbackIndex >= fallbackCDNs.length) {
                    console.log('💡 所有CDN尝试完毕，请检查网络或使用本地资源');
                    // 不再递归调用，避免循环
                }
            }
            
            // 智能检测时机
            function startDetection() {
                // 如果主CDN明显超时，立即开始检测
                var bootstrapCss = document.getElementById('bootstrap-css');
                if (bootstrapCss) {
                    bootstrapCss.addEventListener('error', function() {
                        console.log('🚨 主CDN加载错误，启动备用机制');
                        setTimeout(checkAndSwitch, 300);
                    });
                }
                
                // 延迟检测，给CSS加载时间
                setTimeout(checkAndSwitch, 1500);
                
                // 最终检测（页面完全加载后）
                if (document.readyState === 'complete') {
                    setTimeout(checkAndSwitch, 3000);
                } else {
                    window.addEventListener('load', function() {
                        setTimeout(checkAndSwitch, 3000);
                    });
                }
            }
            
            // 启动检测
            startDetection();
        })();
    </script>
    
    
