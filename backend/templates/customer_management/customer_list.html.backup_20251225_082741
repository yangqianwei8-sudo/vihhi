{% block extra_js %}
<script src="{% static 'js/list-filters.js' %}"></script>
<script src="{% static 'js/filter-fields-settings.js' %}"></script>
<script>
// 初始化筛选字段设置
document.addEventListener('DOMContentLoaded', function() {
    if (typeof FilterFieldsSettings !== "undefined") {
        const filterFieldsSettings = new FilterFieldsSettings({
            storageKey: "customer_list_filter_fields_settings",
            containerId: "basicFilters",
            modalId: "filterFieldsSettingsModal",
            listId: "filterFieldsList",
            settingsBtnId: "settingsFilterFieldsBtn",
            saveBtnId: "saveFilterFieldsSettings",
            resetBtnId: "resetFilterFieldsSettings",
            maxEnabledFields: 10,
            defaultEnabledFields: ['department', 'responsible_user'],
            requiredFields: ['department', 'responsible_user']
        });
        filterFieldsSettings.init();
        console.log("筛选字段设置功能已初始化");
    }
});

// 全选功能
document.addEventListener('DOMContentLoaded', function() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.row-checkbox');
    
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateSelectedCount();
        });
    }
    
    checkboxes.forEach(cb => {
        cb.addEventListener('change', updateSelectedCount);
    });
    
    function updateSelectedCount() {
        const selected = document.querySelectorAll('.row-checkbox:checked').length;
        const countEl = document.getElementById('selectedCount');
        if (countEl) countEl.textContent = selected;
        const deleteBtn = document.getElementById('batchDeleteBtn');
        if (deleteBtn) deleteBtn.disabled = selected === 0;
    }
    
    // 筛选条件展开/收起
    const collapseBtn = document.getElementById('filterCollapseBtn');
    const basicFilters = document.getElementById('basicFilters');
    const collapseText = document.getElementById('filterCollapseText');
    const collapseIcon = document.getElementById('filterCollapseIcon');
    
    if (collapseBtn && basicFilters) {
        collapseBtn.addEventListener('click', function() {
            if (basicFilters.style.display === 'none') {
                basicFilters.style.display = 'block';
                if (collapseText) collapseText.textContent = '收起';
                if (collapseIcon) collapseIcon.textContent = '▲';
            } else {
                basicFilters.style.display = 'none';
                if (collapseText) collapseText.textContent = '展开';
                if (collapseIcon) collapseIcon.textContent = '▼';
            }
        });
    }
});

// 筛选按钮点击事件
document.addEventListener('DOMContentLoaded', function() {
    // 筛选按钮点击处理
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const filterKey = this.getAttribute('data-filter');
            const filterValue = this.getAttribute('data-value');
            const hiddenInput = document.getElementById('filter_' + filterKey);
            
            if (hiddenInput) {
                hiddenInput.value = filterValue;
            } else {
                // 如果没有隐藏输入，创建或更新URL参数
                const form = document.getElementById('filterForm');
                if (form) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = filterKey;
                    input.id = 'filter_' + filterKey;
                    input.value = filterValue;
                    form.appendChild(input);
                }
            }
            
            // 更新按钮状态
            this.parentElement.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('active');
            });
            this.classList.add('active');
            
            // 提交表单
            const form = document.getElementById('filterForm');
            if (form) {
                form.submit();
            }
        });
    });
    
    // 自定义日期范围按钮
    const customDateBtn = document.getElementById('customDateBtn');
    const customDateRange = document.getElementById('customDateRange');
    if (customDateBtn && customDateRange) {
        customDateBtn.addEventListener('click', function() {
            customDateRange.style.display = 'flex';
        });
    }
    
    // 下拉选择框变化时提交表单
    document.querySelectorAll('#filterForm select, #filterForm input[type="text"], #filterForm input[type="number"], #filterForm input[type="date"]').forEach(input => {
        input.addEventListener('change', function() {
            const form = document.getElementById('filterForm');
            if (form) {
                // 延迟提交，避免频繁请求
                clearTimeout(window.filterSubmitTimeout);
                window.filterSubmitTimeout = setTimeout(() => {
                    form.submit();
                }, 500);
            }
        });
    });
});

</script>
{% endblock %}
