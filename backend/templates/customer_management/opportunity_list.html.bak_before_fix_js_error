    // 打开模态框时初始化拖动排序
    const filterFieldsModal = document.getElementById('filterFieldsModal');
    if (filterFieldsModal) {
        filterFieldsModal.addEventListener('shown.bs.modal', function() {
            setTimeout(initSortable, 100);
