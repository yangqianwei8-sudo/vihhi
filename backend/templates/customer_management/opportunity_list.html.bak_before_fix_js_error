            const checkboxes = document.querySelectorAll('#columnSettingsList .column-setting-checkbox:checked');
            const visible = Array.from(checkboxes).map(cb => cb.getAttribute('data-column-key'));
            const rows = Array.from(document.querySelectorAll('#columnSettingsList .column-setting-row'));
            const order = rows.map(row => row.getAttribute('data-column-key'));
            
            saveColumnSettings(visible, order);
            applyColumnSettings();
            
            const modal = bootstrap.Modal.getInstance(columnSettingsModal);
            if (modal) modal.hide();
        });
    }
    
    // 重置列设置
    const resetColumnSettingsBtn = document.getElementById('resetColumnSettings');
    if (resetColumnSettingsBtn) {
        resetColumnSettingsBtn.addEventListener('click', function() {
            const defaultVisible = Object.keys(allColumns).filter(key => allColumns[key].default);
            const defaultOrder = defaultVisible;
            
            saveColumnSettings(defaultVisible, defaultOrder);
            applyColumnSettings();
            renderColumnSettingsList();
        });
    }
    
    // 初始化拖动排序功能（使用SortableJS库）
