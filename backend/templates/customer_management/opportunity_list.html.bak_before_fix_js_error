        resetFilterFieldsBtn.addEventListener('click', function() {
            const defaultEnabled = Object.keys(allFilterFields).filter(key => allFilterFields[key].default);
            const defaultOrder = defaultEnabled;
            
            saveFilterFields(defaultEnabled, defaultOrder);
            applyFilterFieldsVisibility();
            renderFilterFieldsList();
        });
    }
    
    // 列设置功能（类似筛选字段功能）
    const allColumns = {
        'checkbox': { label: '选择', default: true, thIndex: 0 },
        'name': { label: '商机名称', default: true, thIndex: 1 },
        'code': { label: '商机编号', default: true, thIndex: 2 },
        'client': { label: '关联客户', default: true, thIndex: 3 },
        'business_manager': { label: '负责商务', default: true, thIndex: 4 },
        'status': { label: '商机状态', default: true, thIndex: 5 },
        'estimated_amount': { label: '预计金额', default: true, thIndex: 6 },
        'success_probability': { label: '成功概率', default: true, thIndex: 7 },
        'weighted_amount': { label: '加权金额', default: true, thIndex: 8 },
        'urgency': { label: '紧急程度', default: false, thIndex: 9 },
        'expected_sign_date': { label: '预计签约时间', default: true, thIndex: 10 },
        'created_time': { label: '创建时间', default: false, thIndex: 11 },
        'actions': { label: '操作', default: true, thIndex: 12 },
    };
    
    // 获取存储的列设置
    function getStoredColumnSettings() {
        const stored = localStorage.getItem('opportunity_column_settings');
        if (stored) {
            try {
                const data = JSON.parse(stored);
                return {
                    visible: data.visible || [],
                    order: data.order || Object.keys(allColumns).filter(key => allColumns[key].default)
                };
            } catch (e) {
            }
        }
        // 返回默认设置
        const defaultVisible = Object.keys(allColumns).filter(key => allColumns[key].default);
