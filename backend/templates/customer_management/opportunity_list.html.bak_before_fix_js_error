    let columnSettingsSortable = null;
    
    function initSortable() {
        // 筛选字段拖动排序
        const filterFieldsList = document.getElementById('filterFieldsList');
        if (filterFieldsList && typeof Sortable !== 'undefined') {
            filterFieldsSortable = new Sortable(filterFieldsList, {
                animation: 150,
                handle: '.filter-field-drag-handle',
                onStart: function(evt) {
                    evt.item.classList.add('dragging');
                },
                onEnd: function(evt) {
                    evt.item.classList.remove('dragging');
                }
            });
        }
        
        // 列设置拖动排序
        const columnSettingsList = document.getElementById('columnSettingsList');
        if (columnSettingsList && typeof Sortable !== 'undefined') {
            columnSettingsSortable = new Sortable(columnSettingsList, {
                animation: 150,
                handle: '.column-setting-drag-handle',
                onStart: function(evt) {
                    evt.item.classList.add('dragging');
                },
                onEnd: function(evt) {
                    evt.item.classList.remove('dragging');
                }
            });
        }
