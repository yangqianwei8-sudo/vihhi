            visible: visible,
            order: order
        }));
    }
    
    // 应用列设置显示/隐藏和顺序
    function applyColumnSettings() {
        const settings = getStoredColumnSettings();
        const table = document.querySelector('.list-page-table');
        if (!table) return;
        
        const thead = table.querySelector('thead tr');
        const tbody = table.querySelector('tbody');
        if (!thead || !tbody) return;
        
        // 获取所有表头列
        const ths = Array.from(thead.querySelectorAll('th'));
        const tbodyRows = Array.from(tbody.querySelectorAll('tr'));
        
        // 创建列索引映射
        const columnMap = {};
        ths.forEach((th, index) => {
            const columnKey = Object.keys(allColumns).find(key => {
                const col = allColumns[key];
                return col && col.thIndex === index;
            });
            if (columnKey) {
                columnMap[columnKey] = { th, index };
            }
        });
        
        // 按顺序重新排列列
        const orderedColumns = [];
        settings.order.forEach(columnKey => {
            if (columnMap[columnKey]) {
                orderedColumns.push(columnMap[columnKey]);
            }
        });
        
        // 应用显示/隐藏和顺序
        Object.keys(allColumns).forEach(columnKey => {
            const col = allColumns[columnKey];
            const map = columnMap[columnKey];
            if (!map) return;
            
            const isVisible = settings.visible.includes(columnKey);
            const newIndex = settings.order.indexOf(columnKey);
            
            // 显示/隐藏表头
            if (isVisible) {
                map.th.style.display = '';
