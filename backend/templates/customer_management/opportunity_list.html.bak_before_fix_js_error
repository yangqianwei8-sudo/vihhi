document.addEventListener('DOMContentLoaded', function() {
    // 定义所有可用的筛选字段
    const allFilterFields = {
        'status': { label: '商机状态', default: true },
        'client_id': { label: '关联客户', default: true },
        'business_manager_id': { label: '负责商务', default: true },
        'urgency': { label: '紧急程度', default: true },
        'expected_sign_date': { label: '预计签约时间', default: false },
        'created_time': { label: '创建时间', default: false },
        'estimated_amount': { label: '预计金额', default: false },
    };
    
    // 获取存储的筛选字段设置
    function getStoredFilterFields() {
        const stored = localStorage.getItem('opportunity_filter_fields');
        if (stored) {
            try {
                const data = JSON.parse(stored);
                return {
                    enabled: data.enabled || [],
                    order: data.order || Object.keys(allFilterFields).filter(key => allFilterFields[key].default)
                };
            } catch (e) {
            }
        }
        // 返回默认设置
        const defaultEnabled = Object.keys(allFilterFields).filter(key => allFilterFields[key].default);
        return {
            enabled: defaultEnabled,
            order: defaultEnabled
        };
    }
    
    // 保存筛选字段设置
    function saveFilterFields(enabled, order) {
        localStorage.setItem('opportunity_filter_fields', JSON.stringify({
            enabled: enabled,
            order: order
        }));
    }
    
    // 应用筛选字段显示/隐藏和顺序
    function applyFilterFieldsVisibility() {
        const settings = getStoredFilterFields();
        const container = document.getElementById('filterFieldsContainer');
        if (!container) return;
        
        // 获取所有筛选项并按顺序重新排列
        const filterItems = Array.from(container.querySelectorAll('.list-page-filter-item'));
        const orderedItems = [];
        
        settings.order.forEach(fieldKey => {
            const item = filterItems.find(item => item.getAttribute('data-filter-field') === fieldKey);
            if (item) {
                orderedItems.push(item);
            }
        });
        
        // 清空容器并重新添加
        container.textContent = '';
        orderedItems.forEach(item => {
            const fieldKey = item.getAttribute('data-filter-field');
            if (settings.enabled.includes(fieldKey)) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
            container.appendChild(item);
        });
    }
    
    // 渲染筛选字段列表（在模态框中）
    function renderFilterFieldsList() {
        const container = document.getElementById('filterFieldsList');
        if (!container) return;
        
        const settings = getStoredFilterFields();
        container.textContent = '';
        
        settings.order.forEach(fieldKey => {
            const fieldInfo = allFilterFields[fieldKey];
            if (!fieldInfo) return;
            
            const isEnabled = settings.enabled.includes(fieldKey);
            const row = document.createElement('tr');
            row.className = 'filter-field-row';
            row.setAttribute('data-field-key', fieldKey);
            // TODO: 使用DOMPurify清理HTML
            row.innerHTML = `
                <td>
                    <input type="checkbox" class="form-check-input filter-field-checkbox" 
                           ${isEnabled ? 'checked' : ''} 
                           data-field-key="${fieldKey}">
                </td>
                <td class="filter-field-label">${fieldInfo.label}</td>
                <td>
                    <i class="bi bi-grip-vertical filter-field-drag-handle" style="cursor: move; color: var(--vh-text-muted);"></i>
                </td>
            `;
            container.appendChild(row);
        });
    }
    
    // 初始化筛选字段功能
    applyFilterFieldsVisibility();
    
    // 打开模态框时渲染列表
    const filterFieldsModal = document.getElementById('filterFieldsModal');
    if (filterFieldsModal) {
        filterFieldsModal.addEventListener('show.bs.modal', function() {
            renderFilterFieldsList();
        });
    }
    
    // 保存筛选字段设置
    const saveFilterFieldsBtn = document.getElementById('saveFilterFields');
    if (saveFilterFieldsBtn) {
        saveFilterFieldsBtn.addEventListener('click', function() {
            const checkboxes = document.querySelectorAll('#filterFieldsList .filter-field-checkbox:checked');
            const enabled = Array.from(checkboxes).map(cb => cb.getAttribute('data-field-key'));
            const rows = Array.from(document.querySelectorAll('#filterFieldsList .filter-field-row'));
            const order = rows.map(row => row.getAttribute('data-field-key'));
            
            saveFilterFields(enabled, order);
            applyFilterFieldsVisibility();
            
            const modal = bootstrap.Modal.getInstance(filterFieldsModal);
            if (modal) modal.hide();
        });
    }
    
    // 重置筛选字段设置
