{% extends "shared/base.html" %}
{% load static %}

{% block extra_css %}
<link rel="stylesheet" href="{% static 'css/layouts/workspace.css' %}">
{% block module_extra_css %}{% endblock %}
{% endblock %}

{% block content %}
{% if module_sidebar_nav %}
{# 统一模块布局 - 使用统一样式模板，带左侧菜单 #}
<div class="workspace workspace-two-column">
    <!-- 左侧导航菜单 -->
    <aside class="workspace-nav">
        <nav class="sidenav" aria-label="模块导航">
            <div class="sidenav-section">
                <div class="sidenav-links">
                    {% for menu_group in module_sidebar_nav %}
                    {% with has_children=menu_group.children|length|default:0 %}
                    <div class="sidenav-item 
                                {% if menu_group.active %}active{% endif %}
                                {% if menu_group.active or menu_group.expanded %}expanded{% endif %}
                                {% if has_children > 0 %}has-children{% endif %}">
                        
                        {% if has_children > 0 %}
                        {# 有子菜单：使用链接，点击展开/折叠 #}
                        <a class="sidenav-link sidenav-toggle" 
                           href="{{ menu_group.url|default:'#' }}"
                           role="button"
                           aria-expanded="{% if menu_group.active or menu_group.expanded %}true{% else %}false{% endif %}"
                           aria-controls="submenu-{{ forloop.counter }}"
                           {% if menu_group.active %}data-active="true" aria-current="page"{% endif %}>
                            {% if menu_group.icon %}<span class="sidenav-icon">{{ menu_group.icon }}</span>{% endif %}
                            <span class="sidenav-label">{{ menu_group.label }}</span>
                        </a>
                        
                        <div id="submenu-{{ forloop.counter }}" class="submenu" 
                             {% if not menu_group.active and not menu_group.expanded %}style="display: none;"{% endif %}>
                            {% for child in menu_group.children %}
                            <a class="sidenav-link sidenav-sub-link {% if child.active %}active{% endif %}" 
                               href="{{ child.url|default:'#' }}" 
                               {% if child.active %}data-active="true" aria-current="page"{% endif %}>
                                {% if child.icon %}<span class="sidenav-icon">{{ child.icon }}</span>{% endif %}
                                <span class="sidenav-label">{{ child.label }}</span>
                            </a>
                            {% endfor %}
                        </div>
                        
                        {% else %}
                        {# 无子菜单：使用普通链接 #}
                        <a class="sidenav-link {% if menu_group.active %}active{% endif %}" 
                           href="{{ menu_group.url|default:'#' }}"
                           {% if menu_group.active %}data-active="true" aria-current="page"{% endif %}>
                            {% if menu_group.icon %}<span class="sidenav-icon">{{ menu_group.icon }}</span>{% endif %}
                            <span class="sidenav-label">{{ menu_group.label }}</span>
                        </a>
                        {% endif %}
                        
                    </div>
                    {% endwith %}
                    {% endfor %}
                </div>
            </div>
        </nav>
    </aside>

    <!-- 主内容区域 -->
    <main class="workspace-main" id="main-content">
        <div class="workspace-content">
            {% block module_content %}{% endblock %}
        </div>
    </main>
</div>
{% else %}
    <main class="workspace-main" id="main-content">
        <div class="workspace-content">
            
        </div>
    </main>
{% endif %}
{% endblock %}

{% block extra_js %}
{% if module_sidebar_nav %}
<script src="{% static 'js/sidebar.js' %}" defer></script>
{% endif %}
{% block module_extra_js %}{% endblock %}
{% endblock %}
