{% load static %}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block home_page_title %}{{ page_title }} - 维海科技信息化管理平台{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- 统一样式 -->
    <link rel="stylesheet" href="{% static 'css/common.css' %}">
    
    {% block home_page_extra_css %}
    <style>
        :root {
            --primary-color: #4361ee;
            --warning-color: #f9c74f;
            --danger-color: #f94144;
            --success-color: #4cc9f0;
            --light-bg: #f5f7fb;
            --card-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            --card-shadow-hover: 0 8px 24px rgba(0, 0, 0, 0.12);
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fb 0%, #e8ecf1 100%);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }
        
        .home-container {
            padding: 0;
            padding-top: 0;
            padding-bottom: 0;
            background: transparent;
        }
        
        .home-container > *:first-child {
            margin-top: 0;
        }
        
        .home-container > *:last-child {
            margin-bottom: 0;
        }
        
        .page-header-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 2rem;
            color: white;
            margin-bottom: 2rem;
            box-shadow: var(--card-shadow);
        }
        
        .page-header-section h1 {
            color: white;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .page-header-section p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            margin-bottom: 0;
        }
        
        .stats-card {
            border-radius: 16px;
            border: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
            cursor: pointer;
            overflow: hidden;
            position: relative;
            background: white;
        }
        
        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--success-color));
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }
        
        .stats-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: var(--card-shadow-hover);
        }
        
        .stats-card:hover::before {
            transform: scaleX(1);
        }
        
        .stats-card .card-body {
            padding: 1.75rem;
        }
        
        .stats-card-icon {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            background: linear-gradient(135deg, rgba(67, 97, 238, 0.1), rgba(67, 97, 238, 0.05));
            transition: all 0.3s ease;
        }
        
        .stats-card:hover .stats-card-icon {
            transform: scale(1.1) rotate(5deg);
        }
        
        .stats-card-value {
            font-size: 2.25rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .quick-actions-bar {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
            margin-bottom: 2rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .main-content {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(0, 0, 0, 0.05);
            margin-bottom: 2rem;
        }
        
        .main-content h5 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #e2e8f0;
        }
        
        .sidebar {
            background: white;
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(0, 0, 0, 0.05);
            height: fit-content;
            position: sticky;
            top: 2rem;
        }
        
        .sidebar h5 {
            font-size: 1.125rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 1.5rem;
        }
        
        .module-card {
            border: none;
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            transition: all 0.3s ease;
        }
        
        .module-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--card-shadow-hover);
        }
        
        .module-card-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }
        
        @media (max-width: 768px) {
            .page-header-section {
                padding: 1.5rem;
            }
            
            .page-header-section h1 {
                font-size: 1.5rem;
            }
            
            .stats-card-value {
                font-size: 1.75rem;
            }
        }
    </style>
    {% endblock %}
</head>
<body>
    <!-- 顶部导航栏 -->
    {% block home_page_top_nav %}
    {% if full_top_nav %}
        {% include 'shared/top_nav.html' %}
    {% endif %}
    {% endblock %}
    
    <div class="container-fluid">
        <div class="row">
        {% if module_sidebar_nav %}
        <div class="workspace workspace-two-column customer-management-layout">
            <aside class="workspace-nav">
                <nav class="sidenav">
                    <div class="sidenav-section">
                        <div class="sidenav-links">
                            {% for menu_group in module_sidebar_nav %}
                            {% with has_children=menu_group.children|length|default:0 %}
                            <div class="sidenav-item 
                                        {% if menu_group.active %}active{% endif %}
                                        {% if menu_group.active or menu_group.expanded %}expanded{% endif %}
                                        {% if has_children > 0 %}has-children{% endif %}">
                                
                                {% if has_children > 0 %}
                                <a class="sidenav-link sidenav-toggle" 
                                   href="{{ menu_group.url|default:'#' }}"
                                   role="button"
                                   aria-expanded="{% if menu_group.active or menu_group.expanded %}true{% else %}false{% endif %}"
                                   aria-controls="submenu-{{ forloop.counter }}"
                                   {% if menu_group.active %}data-active="true" aria-current="page"{% endif %}>
                                    {% if menu_group.icon %}<span class="sidenav-icon">{{ menu_group.icon }}</span>{% endif %}
                                    <span class="sidenav-label">{{ menu_group.label }}</span>
                                </a>
                                
                                <div id="submenu-{{ forloop.counter }}" class="submenu" 
                                     {% if not menu_group.active and not menu_group.expanded %}style="display: none;"{% endif %}>
                                    {% for child in menu_group.children %}
                                    <a class="sidenav-link sidenav-sub-link {% if child.active %}active{% endif %}" 
                                       href="{{ child.url|default:'#' }}" 
                                       {% if child.active %}data-active="true" aria-current="page"{% endif %}>
                                        {% if child.icon %}<span class="sidenav-icon">{{ child.icon }}</span>{% endif %}
                                        <span class="sidenav-label">{{ child.label }}</span>
                                    </a>
                                    {% endfor %}
                                </div>
                                
                                {% else %}
                                <a class="sidenav-link {% if menu_group.active %}active{% endif %}" 
                                   href="{{ menu_group.url|default:'#' }}"
                                   {% if menu_group.active %}data-active="true" aria-current="page"{% endif %}>
                                    {% if menu_group.icon %}<span class="sidenav-icon">{{ menu_group.icon }}</span>{% endif %}
                                    <span class="sidenav-label">{{ menu_group.label }}</span>
                                </a>
                                {% endif %}
                                
                            </div>
                            {% endwith %}
                            {% endfor %}
                        </div>
                    </div>
                </nav>
            </aside>
            
            <main class="workspace-main customer-content">
        {% else %}
        <div class="workspace-content">
        {% endif %}
                <div class="home-container">
                    {% block home_page_header %}
                    <div class="page-header-section">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-2">
                                    {% if page_icon %}
                                    <div class="me-3" style="font-size: 2.5rem; opacity: 0.9;">{{ page_icon }}</div>
                                    {% endif %}
                                    <div>
                                        <h1 class="mb-0">{{ page_title }}</h1>
                                    </div>
                                </div>
                            </div>
                            <button class="btn btn-light btn-sm" onclick="location.reload()" style="border-radius: 8px; backdrop-filter: blur(10px); background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3);">
                                <i class="bi bi-arrow-clockwise me-1"></i> 刷新
                            </button>
                        </div>
                    </div>
                    {% endblock %}
                    
                    {% block home_page_summary_cards %}
                    {% if summary_cards %}
                    <div class="position-relative">
                    <div class="row g-4 mb-4">
                        {% for card in summary_cards %}
                        <div class="col-md-3 col-sm-6">
                            <div class="card stats-card shadow-sm" 
                                 {% if card.url %}onclick="window.location.href='{{ card.url }}'"{% endif %}>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="text-muted mb-3" style="font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">{{ card.label }}</h6>
                                            <h3 class="stats-card-value mb-2">{{ card.value }}</h3>
                                            {% if card.subvalue %}
                                            <small class="text-muted" style="font-size: 0.8125rem;">{{ card.subvalue }}</small>
                                            {% endif %}
                                            {% if card.hint %}
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">{{ card.hint }}</small>
                                            {% endif %}
                                        </div>
                                        {% if card.icon %}
                                        <div class="stats-card-icon">
                                            {{ card.icon }}
                                        </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    </div>
                    {% endif %}
                    {% endblock %}
                    
                    {% block home_page_quick_actions %}
                    {% endblock %}
                    
                    {% block home_page_sections %}
                    {% if sections %}
                    <div class="row">
                        <div class="col-lg-{% if sections.0.items|length > 0 %}9{% else %}12{% endif %}">
                            <div class="main-content">
                                {% for section in sections %}
                                <div class="mb-4 {% if not forloop.last %}border-bottom pb-4{% endif %}">
                                    <h5 class="fw-bold mb-3">{{ section.title }}</h5>
                                    {% if section.description %}
                                    <p class="text-muted mb-4">{{ section.description }}</p>
                                    {% endif %}
                                    
                                    {% if section.layout == 'grid' %}
                                    <div class="row g-3">
                                        {% for item in section.items %}
                                        <div class="col-md-4">
                                            <div class="card module-card h-100">
                                                <div class="card-body">
                                                    {% if item.icon %}
                                                    <span class="module-card-icon">{{ item.icon }}</span>
                                                    {% endif %}
                                                    <h5 class="card-title fw-bold mb-3">
                                                        {{ item.label }}
                                                    </h5>
                                                    {% if item.description %}
                                                    <p class="card-text text-muted mb-3">{{ item.description }}</p>
                                                    {% endif %}
                                                    {% if item.url %}
                                                    <a href="{{ item.url }}" class="btn btn-outline-primary btn-sm">
                                                        {{ item.link_label|default:'进入模块 →' }}
                                                    </a>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                        {% endfor %}
                                    </div>
                                    {% else %}
                                    <div class="list-group">
                                        {% for item in section.items %}
                                        <a href="{{ item.url|default:'#' }}" class="list-group-item list-group-item-action">
                                            {% if item.icon %}<span class="me-2">{{ item.icon }}</span>{% endif %}
                                            <strong>{{ item.label }}</strong>
                                            {% if item.description %}
                                            <small class="d-block text-muted mt-1">{{ item.description }}</small>
                                            {% endif %}
                                        </a>
                                        {% endfor %}
                                    </div>
                                    {% endif %}
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        
                        {% block home_page_sidebar %}
                        {% if sections.0.items|length > 0 %}
                        <div class="col-lg-3">
                            <div class="sidebar">
                                <h5 class="fw-bold mb-4">最近活动</h5>
                                
                                <div class="activity-item">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="fw-semibold">欢迎使用</span>
                                        <span class="activity-time">{% now "H:i" %}</span>
                                    </div>
                                    <p class="small mb-1">系统已就绪</p>
                                    <small class="text-muted">系统 · 刚刚</small>
                                </div>
                                
                                <div class="text-center mt-4">
                                    <a href="#" class="text-decoration-none small">
                                        <i class="bi bi-clock-history me-1"></i> 查看全部活动记录
                                    </a>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                        {% endblock %}
                    </div>
                    {% endif %}
                    {% endblock %}
                    
                    {% block home_page_content %}
                    {% endblock %}
                </div>
        {% if module_sidebar_nav %}
            </main>
        </div>
        {% else %}
        </div>
        {% endif %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    {% block home_page_extra_js %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.stats-card').forEach((card, index) => {
                card.addEventListener('click', function() {
                    this.style.transform = 'scale(0.98)';
                    setTimeout(() => {
                        this.style.transform = '';
                    }, 200);
                });
            });
            
            const elements = document.querySelectorAll('.stats-card, .main-content, .sidebar');
            elements.forEach((el, index) => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    el.style.transition = 'all 0.5s ease-out';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
    {% endblock %}
    
    <script src="{% static 'js/sidebar.js' %}"></script>
</body>
</html>
