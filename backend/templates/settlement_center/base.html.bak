<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}维海科技信息化管理平台{% endblock %}</title>
    {% load static %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="{% static 'css/common.css' %}">
    <style>
        body {
            padding-top: 56px;
        }
    </style>
    {% block extra_css %}{% endblock %}
</head>
<body>
    {% include "shared/_top_nav.html" %}

    <div class="container-fluid py-3">
        {% if messages %}
        <div class="alert-container">
            {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        
        {% if settlement_menu %}
        {# 结算中心布局 - 使用统一样式模板，带左侧菜单 #}
        <div class="workspace workspace-two-column settlement-center-layout">
            <!-- 左侧导航菜单 -->
            <aside class="workspace-nav">
                <nav class="sidenav">
                    <div class="sidenav-section">
                        <div class="sidenav-links">
                            {% for menu_group in settlement_menu %}
                            <div class="sidenav-item {% if menu_group.active or menu_group.expanded %}expanded{% endif %}">
                                <a class="sidenav-link" 
                                   href="{% if menu_group.url %}{{ menu_group.url }}{% else %}#{% endif %}" 
                                   {% if menu_group.active %}data-active="true"{% endif %}>
                                    {% if menu_group.icon %}<span>{{ menu_group.icon }}</span>{% endif %}
                                    <span>{{ menu_group.label }}</span>
                                    {% if menu_group.children %}<span class="menu-arrow">▶</span>{% endif %}
                                </a>
                                {% if menu_group.children %}
                                <div class="submenu">
                                    {% for child in menu_group.children %}
                                    <a class="sidenav-link sidenav-sub-link" 
                                       href="{{ child.url }}" 
                                       {% if child.active %}data-active="true"{% endif %}>
                                        {% if child.icon %}<span>{{ child.icon }}</span>{% endif %}
                                        <span>{{ child.label }}</span>
                                    </a>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </div>
            </aside>
            
            <!-- 主内容区域 -->
            <main class="workspace-main settlement-center-content">
        {% else %}
        <div class="workspace-content">
        {% endif %}
        
        {% block content %}
        {% if settlement_menu %}
            </main>
        </div>
        {% else %}
        </div>
        {% endif %}
        
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block extra_js %}{% endblock %}

    <script src="{% static 'js/sidebar.js' %}"></script>
</body>
</html>



{% endblock %}